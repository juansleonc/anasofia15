---
// Gold foil ribbons and glitter specks falling gently from the garland's lower edge toward the
// bottom of the cover. SSR'd from the seeded `fallingConfetti` layout, so there is no client
// script. The layer is a size container, so the one shared keyframe can move every piece in `cqh`
// (a share of the cover's height) using transform and opacity only. Under reduced motion each
// piece stops at its own seeded resting height instead, so the cover still reads as festive.
import { fallingConfetti, driftingSparkles, RIBBON_WIDTH_PX } from '../lib/sparkles';

const RIBBON_COUNT = 8;
const SEED = 1515;

const pieces = fallingConfetti({ ribbons: RIBBON_COUNT, seed: SEED });

// Light drifts from the garland toward the centre, not just falling or twinkling in place. Lives
// in this layer (not a new mount) because it is already the cover-sized `container-type: size`
// layer below `.cover__content` — see lib/sparkles.ts `driftingSparkles`.
const DRIFT_SEED = 3344;
const drift = driftingSparkles({ glitter: 12, stars: 6, bokeh: 4, seed: DRIFT_SEED });

// Soft static bokeh along the garland's lower edge and in the side gutters beside the text block,
// clear of the lead, name and button at portrait and landscape: [x %, y %, diameter px, opacity].
const BOKEH: readonly (readonly [number, number, number, number])[] = [
  [8, 30, 46, 0.5],
  [92, 33, 40, 0.45],
  [64, 26, 30, 0.45],
  [5, 60, 34, 0.4],
  [95, 64, 38, 0.4],
  [7, 90, 44, 0.35],
];

// Golden light flares glinting on the garland, like the reference's sparkle points:
// [x %, y %, size px].
const FLARES: readonly (readonly [number, number, number])[] = [
  [31, 14, 38],
  [72, 22, 32],
  [58, 9, 26],
];

function round(value: number): string {
  return value.toFixed(2);
}
---

<div class="cover-confetti" data-testid="cover-confetti" aria-hidden="true">
  {
    pieces.map((piece) => {
      const vars =
        `--confetti-x:${round(piece.xPct)}%;` +
        `--confetti-length:${round(piece.lengthPx)}px;` +
        `--confetti-duration:${Math.round(piece.durationMs)}ms;` +
        `--confetti-delay:${Math.round(piece.delayMs)}ms;` +
        `--confetti-drift:${round(piece.driftPx)}px;` +
        `--confetti-spin:${round(piece.spinDeg)}deg;` +
        `--confetti-rest:${round(piece.restYPct)}cqh;`;
      return (
        <span
          class={`cover-confetti__piece cover-confetti__${piece.kind}`}
          data-confetti={piece.kind}
          style={vars}
        />
      );
    })
  }
  {
    BOKEH.map(([xPct, yPct, sizePx, opacity]) => (
      <span
        class="cover-confetti__bokeh"
        data-bokeh
        style={`left:${xPct}%;top:${yPct}%;--bokeh-size:${sizePx}px;opacity:${opacity};`}
      />
    ))
  }
  {
    FLARES.map(([xPct, yPct, sizePx]) => (
      <span
        class="cover-confetti__flare"
        data-flare
        style={`left:${xPct}%;top:${yPct}%;--flare-size:${sizePx}px;`}
      />
    ))
  }
  {
    drift.map((particle, index) => {
      // Alternating sideways sway so the drift reads as organic motion rather than every piece
      // swinging the same way at the midpoint of its path.
      const swayPx = index % 2 === 0 ? 12 : -12;
      const vars =
        `--drift-x:${round(particle.xPct)}%;` +
        `--drift-y:${round(particle.yPct)}%;` +
        `--drift-dx:${round(particle.dxPct)}cqw;` +
        `--drift-dy:${round(particle.dyPct)}cqh;` +
        `--drift-sway:${swayPx}px;` +
        `--drift-size:${round(particle.sizePx)}px;` +
        `--drift-peak:${particle.peakOpacity};` +
        `--drift-duration:${Math.round(particle.durationMs)}ms;` +
        `--drift-delay:${Math.round(particle.delayMs)}ms;`;
      return (
        <span
          class={`cover-confetti__drift cover-confetti__drift-${particle.kind}`}
          data-drift={particle.kind}
          style={vars}
        />
      );
    })
  }
</div>

<style define:vars={{ ribbonWidth: `${RIBBON_WIDTH_PX}px` }}>
  .cover-confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }

  .cover-confetti__piece {
    position: absolute;
    top: 0;
    left: var(--confetti-x);
    opacity: 0;
    animation: cover-confetti-fall var(--confetti-duration) linear var(--confetti-delay) infinite;
  }

  .cover-confetti__ribbon {
    width: var(--ribbonWidth);
    height: var(--confetti-length);
    border-radius: 1px;
    background-image: linear-gradient(
      180deg,
      var(--c-champagne-300),
      var(--c-champagne-500) 55%,
      var(--c-champagne-700)
    );
  }

  .cover-confetti__bokeh {
    position: absolute;
    width: var(--bokeh-size);
    height: var(--bokeh-size);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-champagne-100) 70%, transparent) 0%,
      color-mix(in srgb, var(--c-champagne-200) 35%, transparent) 55%,
      transparent 72%
    );
  }

  /* A gold 4-point flare: a soft halo (the span) behind a clipped star body (::after) — see the
     shared rule below, also used by the drifting star. */
  .cover-confetti__flare {
    position: absolute;
    width: var(--flare-size);
    height: var(--flare-size);
    transform: translate(-50%, -50%);
  }

  /* Shared by all three drift kinds: spawns at its garland position, scaled down and invisible,
     drifts toward the text block's centre while growing to full scale, and fades back out. Each
     kind names its own keyframe (below) so the star can add rotation and the glitter a flicker,
     while all three still animate only transform and opacity. */
  .cover-confetti__drift {
    position: absolute;
    left: var(--drift-x);
    top: var(--drift-y);
    width: var(--drift-size);
    height: var(--drift-size);
    opacity: 0;
    animation-name: cover-sparkle-drift;
    animation-duration: var(--drift-duration);
    animation-timing-function: ease-in-out;
    animation-delay: var(--drift-delay);
    animation-iteration-count: infinite;
  }

  /* A crisp metallic speck, gold at its edge rather than a plain white dot. */
  .cover-confetti__drift-glitter {
    border-radius: 50%;
    background-image: radial-gradient(
      circle,
      var(--c-white) 0%,
      var(--c-white) 15%,
      var(--c-champagne-500) 35%,
      var(--c-champagne-700) 68%,
      transparent 72%
    );
    animation-name: cover-sparkle-drift-glitter;
  }

  /* A gold 4-point star: a soft halo behind a clipped, gold-cored body — see the shared rule
     below, also used by the static flares. */
  .cover-confetti__drift-star {
    animation-name: cover-sparkle-drift-star;
  }

  .cover-confetti__flare,
  .cover-confetti__drift-star {
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-champagne-300) 45%, transparent) 0%,
      transparent 70%
    );
  }

  .cover-confetti__flare::after,
  .cover-confetti__drift-star::after {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(
      50% 0%,
      56.36% 43.64%,
      100% 50%,
      56.36% 56.36%,
      50% 100%,
      43.64% 56.36%,
      0% 50%,
      43.64% 43.64%
    );
    background-image: radial-gradient(
      circle,
      var(--c-white) 0%,
      var(--c-white) 12%,
      var(--c-champagne-300) 30%,
      var(--c-champagne-500) 60%,
      var(--c-champagne-700) 100%
    );
  }

  /* A faint, large out-of-focus disc. */
  .cover-confetti__drift-bokeh {
    border-radius: 50%;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-champagne-100) 70%, transparent) 0%,
      color-mix(in srgb, var(--c-champagne-200) 35%, transparent) 55%,
      transparent 72%
    );
  }

  /* Used by bokeh: a single rise, hold and fall, no flicker or rotation. */
  @keyframes cover-sparkle-drift {
    0% {
      transform: translate(-50%, -50%) translate(0, 0) scale(0.6);
      opacity: 0;
    }
    12% {
      opacity: var(--drift-peak);
    }
    50% {
      transform: translate(-50%, -50%)
        translate(calc(var(--drift-dx) * 0.5 + var(--drift-sway)), calc(var(--drift-dy) * 0.5))
        scale(0.8);
    }
    75% {
      opacity: var(--drift-peak);
    }
    100% {
      transform: translate(-50%, -50%) translate(var(--drift-dx), var(--drift-dy)) scale(1);
      opacity: 0;
    }
  }

  /* Used by the star: the same rise/hold/fall, plus a scale-and-rotate into place. */
  @keyframes cover-sparkle-drift-star {
    0% {
      transform: translate(-50%, -50%) translate(0, 0) scale(0.7) rotate(0deg);
      opacity: 0;
    }
    12% {
      opacity: var(--drift-peak);
    }
    50% {
      transform: translate(-50%, -50%)
        translate(calc(var(--drift-dx) * 0.5 + var(--drift-sway)), calc(var(--drift-dy) * 0.5))
        scale(0.85) rotate(22deg);
    }
    75% {
      opacity: var(--drift-peak);
    }
    100% {
      transform: translate(-50%, -50%) translate(var(--drift-dx), var(--drift-dy)) scale(1)
        rotate(45deg);
      opacity: 0;
    }
  }

  /* Used by glitter: the same rise/hold/fall, with two brief dips so it reads as a flicker. */
  @keyframes cover-sparkle-drift-glitter {
    0% {
      transform: translate(-50%, -50%) translate(0, 0) scale(0.6);
      opacity: 0;
    }
    12% {
      opacity: var(--drift-peak);
    }
    35% {
      opacity: calc(var(--drift-peak) * 0.55);
    }
    50% {
      transform: translate(-50%, -50%)
        translate(calc(var(--drift-dx) * 0.5 + var(--drift-sway)), calc(var(--drift-dy) * 0.5))
        scale(0.8);
      opacity: var(--drift-peak);
    }
    60% {
      opacity: calc(var(--drift-peak) * 0.55);
    }
    75% {
      opacity: var(--drift-peak);
    }
    100% {
      transform: translate(-50%, -50%) translate(var(--drift-dx), var(--drift-dy)) scale(1);
      opacity: 0;
    }
  }

  @keyframes cover-confetti-fall {
    0% {
      transform: translate(0, 22cqh) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    85% {
      opacity: 0.75;
    }
    100% {
      transform: translate(var(--confetti-drift), 95cqh) rotate(var(--confetti-spin));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-confetti__piece {
      animation: none;
      opacity: 0.7;
      transform: translateY(var(--confetti-rest)) rotate(var(--confetti-spin));
    }

    /* Freezes each drift particle 35% of the way along its path, still visible, instead of mid-
       flight animation. */
    .cover-confetti__drift {
      animation: none;
      transform: translate(-50%, -50%)
        translate(calc(var(--drift-dx) * 0.35), calc(var(--drift-dy) * 0.35)) scale(0.74);
      opacity: calc(var(--drift-peak) * 0.8);
    }
  }
</style>
