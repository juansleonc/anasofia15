---
// Reusable silver mirror-ball (no raster image, no 3D library, per the design's rejection of
// both alternatives). The facets are an inline SVG generated at build time: mirror tiles laid
// out as horizontal latitude bands wrapping a sphere whose poles point up/down — the ball as
// photographed head-on, with the camera a few degrees above so the rows curve gently and the
// top pole peeks over the upper rim. Each tile is orthographically projected (foreshortening
// toward the left/right limb and toward the poles) and shaded by a fixed light (Lambert +
// specular) plus seeded per-tile jitter so individual mirrors catch the light the way a real
// ball does. The spin is a seamless sheen sweeping horizontally across the facet layer, reading
// as rotation about the vertical hanging axis; `prefers-reduced-motion` freezes spin and
// glints, following the Starfield precedent (an explicit `animation: none` in the component's
// own media query, not just the zeroed motion-duration token).

interface FacetTile {
  d: string;
  fill: string;
}

interface Props {
  /** Must be distinct per instance on a page: it drives the facet/twinkle pattern AND the
   * suffix that keeps this instance's SVG gradient ids from colliding with its siblings'. */
  seed?: number;
  /** Target tile edge length in viewBox units — raise it on small balls so they render fewer,
   * coarser facets instead of tripling the inline-SVG weight. */
  tileArc?: number;
  /** How many scattered twinkle pops to seed across the sphere. */
  sparkleCount?: number;
}

const { seed = 2026, tileArc = 15, sparkleCount = 26 } = Astro.props;

const SIZE = 200;
const CENTER = SIZE / 2;
const RADIUS = 97;
const ROW_COUNT = Math.round((Math.PI * RADIUS) / tileArc); // latitude rows, pole to pole
const TILT = (12 * Math.PI) / 180; // camera slightly above the equator, like a hung ball seen standing
const COS_TILT = Math.cos(TILT);
const SIN_TILT = Math.sin(TILT);

// Deterministic PRNG (mulberry32) so every build renders the identical ball for a given seed.
function makeRandom(seed: number): () => number {
  let state = seed;
  return () => {
    state |= 0;
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const random = makeRandom(seed);

// Per-instance suffix for the glint gradient ids: several balls on one page must not emit
// duplicate `id` attributes, or every ball would resolve its fills against the first one's defs.
const glintUid = seed.toString(36);
const silverGlintId = `disco-glint-silver-${glintUid}`;
const goldGlintId = `disco-glint-gold-${glintUid}`;

function normalize(v: [number, number, number]): [number, number, number] {
  const len = Math.hypot(v[0], v[1], v[2]);
  return [v[0] / len, v[1] / len, v[2] / len];
}

// Fixed key light: upper-left, angled toward the viewer (SVG y axis points down).
const LIGHT = normalize([-0.45, -0.55, 0.7]);
const HALF_VECTOR = normalize([LIGHT[0], LIGHT[1], LIGHT[2] + 1]);

function lerpChannel(a: number, b: number, t: number): number {
  return Math.round(a + (b - a) * t);
}

// Silver ramp: near-black steel in shadow, polished silver mid, pure white where a mirror
// blazes. The dark end sits much lower than a shaded sphere would, because most of a real
// mirror ball reflects the dark room — only the tiles that catch a light go bright.
const RAMP_DARK: [number, number, number] = [0x11, 0x13, 0x18];
const RAMP_MID: [number, number, number] = [0x9d, 0xa3, 0xad];
const RAMP_LIGHT: [number, number, number] = [0xff, 0xff, 0xff];

function silverAt(brightness: number): string {
  const t = Math.min(1, Math.max(0, brightness));
  const [from, to, local] =
    t < 0.5 ? [RAMP_DARK, RAMP_MID, t * 2] : [RAMP_MID, RAMP_LIGHT, (t - 0.5) * 2];
  const hex = (i: number) => lerpChannel(from[i], to[i], local).toString(16).padStart(2, '0');
  return `#${hex(0)}${hex(1)}${hex(2)}`;
}

// View-space position on the unit sphere for a latitude/longitude pair, after tilting the
// camera down by TILT. Axes: x right, y up, z toward the viewer (z > 0 means visible side).
function viewPoint(lat: number, lon: number): [number, number, number] {
  const x = Math.cos(lat) * Math.sin(lon);
  const y = Math.sin(lat);
  const z = Math.cos(lat) * Math.cos(lon);
  return [x, y * COS_TILT - z * SIN_TILT, y * SIN_TILT + z * COS_TILT];
}

function tileBrightness(lat: number, lon: number): number {
  const [nx, ny, nz] = viewPoint(lat, lon);
  // SVG's y axis points down, so the view-space "up" component flips sign.
  const normal: [number, number, number] = [nx, -ny, nz];
  const diffuse = Math.max(
    0,
    normal[0] * LIGHT[0] + normal[1] * LIGHT[1] + normal[2] * LIGHT[2],
  );
  const align = Math.max(
    0,
    normal[0] * HALF_VECTOR[0] + normal[1] * HALF_VECTOR[1] + normal[2] * HALF_VECTOR[2],
  );
  // A mirror tile is binary in practice: either its slightly-off mounting angle bounces a
  // light source at the viewer (blazing near-white) or it reflects the dark room (near-black).
  // A bimodal split models that — smooth Lambert shading alone reads as a matte grey sphere.
  // Tiles facing the key light are far more likely to catch it, so the bright ones cluster
  // into a caustic hotspot upper-left while stray catches speckle the rest of the sphere.
  const catchChance = 0.12 + 0.82 * align ** 8;
  if (random() < catchChance) {
    // Blazing facet: white-hot inside the hotspot cluster, bright silver elsewhere.
    return 0.82 + 0.3 * random() + 0.5 * align ** 14;
  }
  // Dark facet: mostly room reflection, with just enough diffuse + jitter left that the
  // sphere's form still reads and adjacent tiles differ visibly.
  return 0.05 + 0.24 * diffuse + random() * 0.16;
}

function project(lat: number, lon: number): string {
  const [x, y] = viewPoint(lat, lon);
  return `${(CENTER + RADIUS * x).toFixed(1)} ${(CENTER - RADIUS * y).toFixed(1)}`;
}

const tiles: FacetTile[] = [];
for (let row = 0; row < ROW_COUNT; row++) {
  const latFrom = -Math.PI / 2 + (row * Math.PI) / ROW_COUNT;
  const latTo = latFrom + Math.PI / ROW_COUNT;
  const latMid = (latFrom + latTo) / 2;
  const groutLat = (Math.PI / ROW_COUNT) * 0.07;
  const latBottom = latFrom + groutLat;
  const latTop = latTo - groutLat;
  const tileCount = Math.max(
    4,
    Math.round((2 * Math.PI * RADIUS * Math.cos(latMid)) / tileArc),
  );
  const lonStep = (2 * Math.PI) / tileCount;
  const rowOffset = random() * lonStep; // stagger rows so vertical grout lines don't align

  for (let i = 0; i < tileCount; i++) {
    const lonFrom = rowOffset + i * lonStep + lonStep * 0.06;
    const lonTo = rowOffset + (i + 1) * lonStep - lonStep * 0.06;
    const corners: Array<[number, number]> = [
      [latBottom, lonFrom],
      [latBottom, lonTo],
      [latTop, lonTo],
      [latTop, lonFrom],
    ];
    // Cull tiles wrapping onto the far hemisphere; the small margin drops limb slivers that
    // would fold back on themselves, leaving the dark base as the ball's shadowed edge.
    if (corners.some(([la, lo]) => viewPoint(la, lo)[2] < 0.04)) continue;
    const d =
      `M${project(latBottom, lonFrom)}` +
      `L${project(latBottom, lonTo)}` +
      `L${project(latTop, lonTo)}` +
      `L${project(latTop, lonFrom)}Z`;
    tiles.push({ d, fill: silverAt(tileBrightness(latMid, (lonFrom + lonTo) / 2)) });
  }
}

// Scattered twinkles: many small specular pops across the whole visible hemisphere, each on
// its own staggered cycle so the surface shimmers the way hundreds of mirrors do. Positions
// come from a second seeded PRNG (independent of the tile stream) and are rejection-sampled
// onto the front of the sphere, biased slightly toward the lit upper-left.
interface SparklePop {
  cx: string;
  cy: string;
  r: string;
  gold: boolean;
  style: string;
}

const sparkleRandom = makeRandom(seed + 1507);
const sparkles: SparklePop[] = [];
while (sparkles.length < sparkleCount) {
  const lat = Math.asin(sparkleRandom() * 2 - 1);
  const lon = (sparkleRandom() * 2 - 1) * Math.PI;
  const [x, y, z] = viewPoint(lat, lon);
  if (z < 0.3) continue; // keep pops off the limb so they sit on clearly visible tiles
  const towardLight = Math.max(0, x * LIGHT[0] + -y * LIGHT[1] + z * LIGHT[2]);
  if (sparkleRandom() > 0.35 + 0.65 * towardLight) continue; // denser where the light hits
  const duration = 2.6 + sparkleRandom() * 3.2;
  sparkles.push({
    cx: (CENTER + RADIUS * x).toFixed(1),
    cy: (CENTER - RADIUS * y).toFixed(1),
    r: (1.4 + sparkleRandom() * 1.8).toFixed(1),
    gold: sparkleRandom() < 0.16, // a few warm accents; the rest stay silver-white
    style: `--twinkle-duration:${duration.toFixed(2)}s;--twinkle-delay:-${(
      sparkleRandom() * duration
    ).toFixed(2)}s`,
  });
}
---

<div class="disco-ball" data-testid="disco-ball" role="img" aria-label="Disco ball">
  <div class="disco-ball__sphere">
    <svg
      class="disco-ball__facets"
      data-testid="disco-ball-facets"
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      aria-hidden="true"
    >
      {tiles.map((tile) => <path d={tile.d} fill={tile.fill} />)}
    </svg>
    <div class="disco-ball__bloom"></div>
    <div class="disco-ball__shading"></div>
    <svg
      class="disco-ball__glints"
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      aria-hidden="true"
    >
      <defs>
        <radialGradient id={silverGlintId}>
          <stop offset="0%" stop-color="#ffffff"></stop>
          <stop offset="55%" stop-color="#f3f5f8"></stop>
          <stop offset="100%" stop-color="rgba(243, 245, 248, 0)"></stop>
        </radialGradient>
        <radialGradient id={goldGlintId}>
          <stop offset="0%" stop-color="#ffffff"></stop>
          <stop offset="55%" stop-color="#f0d987"></stop>
          <stop offset="100%" stop-color="rgba(240, 217, 135, 0)"></stop>
        </radialGradient>
      </defs>
      {sparkles.map((s) => (
        <circle
          class="disco-ball__glint"
          cx={s.cx}
          cy={s.cy}
          r={s.r}
          fill={s.gold ? `url(#${goldGlintId})` : `url(#${silverGlintId})`}
          style={s.style}
        />
      ))}
    </svg>
  </div>
  <div class="disco-ball__sparkle disco-ball__sparkle--1"></div>
  <div class="disco-ball__sparkle disco-ball__sparkle--2"></div>
  <div class="disco-ball__sparkle disco-ball__sparkle--3"></div>
</div>

<style>
  .disco-ball {
    position: relative;
    /* Sized by whoever mounts it (Cover's cluster sets the var per ball); the clamp is only a
       standalone fallback. aspect-ratio keeps the sphere round at any width. */
    width: var(--disco-ball-size, clamp(120px, 30vw, 200px));
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .disco-ball__sphere {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    /* Dark steel base showing through the grout between mirror tiles. */
    background: radial-gradient(circle at 38% 32%, #4b505a 0%, #23262c 55%, #101114 100%);
    /* Bloom: tight white pop plus the soft halo so the whole ball glows against the starfield. */
    box-shadow:
      0 0 12px 2px rgba(255, 255, 255, 0.3),
      0 0 30px 8px rgba(201, 204, 209, 0.34),
      0 0 80px 22px rgba(201, 204, 209, 0.16);
    overflow: hidden;
  }

  /* Spin about the vertical hanging axis: a sheen mask twice the ball's width (two full
     bright/dim cycles) slides sideways by exactly one cycle per loop, so bands of facets
     brighten and dim in a seamless horizontal wave — the ball turning under the light. */
  .disco-ball__facets {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Deeper troughs than before: as the sheen sweeps, whole bands of blazing tiles visibly
       dim and re-ignite, so the bright/dark facet pattern shifts instead of merely pulsing. */
    mask-image: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.5) 0%,
      #000 15%,
      #000 35%,
      rgba(0, 0, 0, 0.5) 50%,
      #000 65%,
      #000 85%,
      rgba(0, 0, 0, 0.5) 100%
    );
    mask-size: 200% 100%;
    animation: disco-ball-spin calc(var(--motion-duration-slow) * 10) linear infinite;
  }

  /* Caustic bloom over the hotspot cluster: a blurred white blob that bleeds across the tile
     edges where the blazing facets concentrate, the way real hotspots flare a camera. Static,
     so the blur costs nothing per frame. */
  .disco-ball__bloom {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 28%,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 255, 255, 0.55) 13%,
      rgba(255, 255, 255, 0.2) 27%,
      rgba(255, 255, 255, 0) 44%
    );
    filter: blur(7px);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Static lighting over the spinning mirrors: a cool Fresnel rim tracing the limb (so the
     sphere separates from the black sky), a hot core inside the bloom, a faint bounce
     lower-right, and limb darkening that rounds the sphere. First gradient paints on top. */
  .disco-ball__shading {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(210, 225, 250, 0) 76%,
        rgba(210, 225, 250, 0.22) 90%,
        rgba(232, 242, 255, 0.5) 98%,
        rgba(232, 242, 255, 0) 100%
      ),
      radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 16%),
      radial-gradient(circle at 72% 80%, rgba(190, 200, 215, 0.22) 0%, rgba(190, 200, 215, 0) 38%),
      radial-gradient(
        circle at 50% 50%,
        rgba(0, 0, 0, 0) 55%,
        rgba(0, 0, 0, 0.45) 88%,
        rgba(0, 0, 0, 0.68) 100%
      );
    pointer-events: none;
  }

  /* Scattered twinkles: each seeded pop rests dark for most of its cycle then flashes, on its
     own duration/phase, so the whole surface shimmers asynchronously. Opacity-only animation
     keeps it cheap. */
  .disco-ball__glints {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .disco-ball__glint {
    opacity: 0.85;
    animation: disco-ball-twinkle var(--twinkle-duration, 3s) linear var(--twinkle-delay, 0s)
      infinite;
  }

  /* Crisp four-point star flare: thinner arms than a generic star so it reads as a camera
     glint, with a white-hot core fading to gold at the tips and a two-layer glow (tight white
     + wide gold) so the flash carries against the dark facets. */
  .disco-ball__sparkle {
    position: absolute;
    clip-path: polygon(
      50% 0%,
      57% 43%,
      100% 50%,
      57% 57%,
      50% 100%,
      43% 57%,
      0% 50%,
      43% 43%
    );
    background: radial-gradient(circle, #ffffff 0%, #fbf0c4 38%, var(--c-gold) 78%);
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.9)) drop-shadow(0 0 9px var(--c-gold));
    animation: disco-ball-glint calc(var(--motion-duration-slow) * 2) var(--motion-easing)
      infinite;
  }

  /* Hero glint on the darker upper-right limb, clear of the specular hotspot so it pops.
     Star sizes are percentages of the ball so small cluster balls get proportional flares. */
  .disco-ball__sparkle--1 {
    top: 9%;
    left: 56%;
    width: 11%;
    height: 11%;
  }

  /* Cool silver counterpart on the lit right limb. */
  .disco-ball__sparkle--2 {
    top: 42%;
    left: 71%;
    width: 9%;
    height: 9%;
    background: radial-gradient(circle, #ffffff 0%, #f2f4f7 45%, var(--c-silver) 80%);
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.95)) drop-shadow(0 0 9px var(--c-silver));
    animation-duration: calc(var(--motion-duration-slow) * 2.4);
    animation-delay: calc(var(--motion-duration-slow) * -1.1);
  }

  .disco-ball__sparkle--3 {
    top: 71%;
    left: 38%;
    width: 6%;
    height: 6%;
    animation-duration: calc(var(--motion-duration-slow) * 1.7);
    animation-delay: calc(var(--motion-duration-slow) * -0.6);
  }

  @keyframes disco-ball-spin {
    from {
      mask-position: 0% 0%;
    }
    to {
      mask-position: 100% 0%;
    }
  }

  @keyframes disco-ball-twinkle {
    0%,
    54%,
    100% {
      opacity: 0.06;
    }
    62%,
    68% {
      opacity: 1;
    }
    78% {
      opacity: 0.12;
    }
  }

  /* Twinkle: the star rests dim for most of the cycle, then flashes hard and briefly —
     a real mirror catching the light — instead of a symmetric fade in/out. */
  @keyframes disco-ball-glint {
    0%,
    68%,
    100% {
      opacity: 0.55;
      transform: scale(0.7) rotate(0deg);
    }
    78%,
    86% {
      opacity: 1;
      transform: scale(1.3) rotate(12deg);
    }
  }

  /* Explicit freeze (not just a zeroed duration): stops rotation, star glints, and every
     scattered twinkle while the sphere itself stays visible — the pops hold their bright base
     opacity instead of flashing — per the theme's reduced-motion contract. */
  @media (prefers-reduced-motion: reduce) {
    .disco-ball__facets,
    .disco-ball__sparkle,
    .disco-ball__glint {
      animation: none;
    }
  }
</style>
