---
// Single hidden sprite sheet for every balloon/flower/leaf/sparkle shape the cover's arch draws:
// one <svg> holding the shared gradient <defs> plus the reusable <symbol> shapes that
// `BalloonArch.astro` references by id via <use>. Defining each shape exactly once here — the
// same pattern as `RoseSprite.astro` — is what keeps "no duplicate element ids" true no matter
// how many balloons/flowers/leaves a layout places.
//
// Gradient stop-colors read from theme tokens (`style="stop-color: var(--c-…)"`) rather than raw
// hex, so the whole sprite re-themes from the palette alone. No SVG filters
// (feGaussianBlur/feTurbulence): those rasterize per visible instance on iPhone WebKit during
// scroll/animation — the glossy-balloon read comes entirely from layered radial gradients plus a
// shared highlight shape instead.
---

<svg
  class="arch-sprite"
  data-testid="arch-sprite"
  aria-hidden="true"
  focusable="false"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  <defs>
    <!-- Balloon body gradients: every tone is >= 6 stops — hot core, light, mid body, body,
         terminator (darkest, ~85-90%) then a lighter rim stop at 100% — the terminator/rim pair
         is what reads as a lit sphere instead of a flat shaded disc. Chrome tones (rose-gold,
         champagne) keep a sharp, late terminator; their satin siblings widen the stop spacing and
         soften the terminator (no hard rose-600/champagne-700 edge) for a duller, non-mirror finish. -->
    <radialGradient id="balloon-pink-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="18%" style="stop-color: var(--c-rose-100)" />
      <stop offset="40%" style="stop-color: var(--c-rose-200)" />
      <stop offset="62%" style="stop-color: var(--c-rose-300)" />
      <stop offset="86%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-300)" />
    </radialGradient>
    <radialGradient id="balloon-rosegold-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="22%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="40%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="58%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="85%" style="stop-color: var(--c-rose-600)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>
    <radialGradient id="balloon-rosegold-satin-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="28%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="50%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="72%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="90%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>
    <!-- Metallic gold: a hot champagne-100 core, a fast fall through the champagne scale and a
         deep champagne-800 terminator just inside the edge, then a lighter rim. The steep, late
         dark band is what reads as polished foil rather than matte beige. -->
    <radialGradient id="balloon-champagne-gradient" cx="32%" cy="26%" r="78%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="12%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="26%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="42%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="58%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="75%" style="stop-color: var(--c-champagne-700)" />
      <stop offset="89%" style="stop-color: var(--c-champagne-800)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>
    <!-- Gold only: a wide, soft "horizon" band of reflected light across the lower body,
         feathered to nothing on every side. -->
    <radialGradient id="balloon-champagne-horizon" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.45" />
      <stop offset="50%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.22" />
      <stop offset="100%" style="stop-color: var(--c-champagne-200)" stop-opacity="0" />
    </radialGradient>
    <!-- Pearl blush: a low-contrast champagne-to-rose-gold ramp (no gold terminator), so it
         sits with the rose-gold pearls rather than reading as a second gold. -->
    <radialGradient id="balloon-champagne-satin-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="25%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="50%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="72%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="90%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-200)" />
    </radialGradient>

    <!-- Shared across every tone: a soft contact shadow dropped below-right of the body (depth
         where balloons overlap each other) and a warm bottom-up environment tint (floor light
         bouncing into the lower half). One def each keeps the gradient budget low; neither reads
         as tone-specific. -->
    <radialGradient id="balloon-contact-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-rose-700)" stop-opacity="0.28" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="balloon-env-tint" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" style="stop-color: var(--c-champagne-200)" stop-opacity="0.35" />
      <stop offset="45%" style="stop-color: var(--c-champagne-200)" stop-opacity="0" />
    </linearGradient>

    <!-- Knots are tone-matched (a darker shade of the balloon's own body colour) instead of every
         tone sharing one wine-coloured triangle; chrome and satin siblings of a tone share a def. -->
    <linearGradient id="balloon-pink-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-rose-600)" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" />
    </linearGradient>
    <linearGradient id="balloon-rosegold-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-600)" />
    </linearGradient>
    <linearGradient id="balloon-champagne-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-700)" />
    </linearGradient>

    <!-- Pearl finish (rose-gold and pearl-blush balloons): a nacre sheen laid over the body,
         champagne at the upper left melting into rose and then into nothing. -->
    <linearGradient id="balloon-nacre" x1="10%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.45" />
      <stop offset="45%" style="stop-color: var(--c-rose-200)" stop-opacity="0.25" />
      <stop offset="100%" style="stop-color: var(--c-rose-200)" stop-opacity="0" />
    </linearGradient>

    <!-- Shared lighting for every balloon (the `balloon-gloss` symbol below): a softbox
         "window" reflection fading from 70% white, a tight specular hot spot, a champagne
         rim-light crescent (light bounced in from the neighbouring balloons) and an
         ambient-occlusion crescent along the bottom that gives the body weight. -->
    <linearGradient id="balloon-gloss-window" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-white)" stop-opacity="0.7" />
      <stop offset="100%" style="stop-color: var(--c-white)" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="balloon-gloss-spec" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-white)" stop-opacity="1" />
      <stop offset="45%" style="stop-color: var(--c-white)" stop-opacity="0.5" />
      <stop offset="100%" style="stop-color: var(--c-white)" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="balloon-gloss-rim" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" stop-opacity="0" />
      <stop offset="45%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.45" />
      <stop offset="100%" style="stop-color: var(--c-champagne-100)" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="balloon-gloss-ao" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-ink)" stop-opacity="0" />
      <stop offset="70%" style="stop-color: var(--c-ink)" stop-opacity="0" />
      <stop offset="100%" style="stop-color: var(--c-ink)" stop-opacity="0.3" />
    </linearGradient>
    <!-- Shared by every flower: a soft rose shadow offset down-right under the bloom, so it sits
         pressed into the balloons around it instead of floating on top. -->
    <radialGradient id="flower-seat-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-rose-700)" stop-opacity="0.18" />
      <stop offset="60%" style="stop-color: var(--c-rose-700)" stop-opacity="0.1" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" stop-opacity="0" />
    </radialGradient>
    <!-- Flower rings: one gradient per ring, `objectBoundingBox` units (the default — no
         `gradientUnits` attr) so each petal is shaded within its own bounding box, computed before
         its `transform="rotate(… c c)"`. Outer/mid petals point tip-up, so a high `cy` puts the
         lightest stop on the rolled lip and the darkest at the base. The rose `-inner` gradients
         paint the cup crescents instead: centered in the crescent's box, dark at the middle and
         light at the rim, so every nested petal shows a lit lip falling into shadow toward the
         next one — the depth between layers that makes the cup read. -->
    <radialGradient id="rose-pink-outer" cx="34%" cy="8%" r="105%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="30%" style="stop-color: var(--c-rose-200)" />
      <stop offset="65%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="rose-pink-mid" cx="34%" cy="8%" r="105%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="35%" style="stop-color: var(--c-rose-200)" />
      <stop offset="70%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-600)" />
    </radialGradient>
    <radialGradient id="rose-pink-inner" cx="34%" cy="8%" r="105%">
      <stop offset="0%" style="stop-color: var(--c-rose-200)" />
      <stop offset="45%" style="stop-color: var(--c-rose-300)" />
      <stop offset="80%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" />
    </radialGradient>
    <radialGradient id="rose-pink-heart" cx="50%" cy="50%" r="55%">
      <stop offset="0%" style="stop-color: var(--c-rose-700)" />
      <stop offset="55%" style="stop-color: var(--c-rose-600)" />
      <stop offset="85%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-200)" />
    </radialGradient>
    <radialGradient id="rose-cream-outer" cx="50%" cy="8%" r="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="40%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="75%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>
    <radialGradient id="rose-cream-mid" cx="50%" cy="8%" r="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="45%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>
    <radialGradient id="rose-cream-inner" cx="50%" cy="50%" r="52%">
      <stop offset="0%" style="stop-color: var(--c-champagne-700)" />
      <stop offset="50%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="80%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-100)" />
    </radialGradient>
    <radialGradient id="peony-blush-outer" cx="50%" cy="8%" r="100%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="55%" style="stop-color: var(--c-rose-200)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="peony-blush-mid" cx="50%" cy="8%" r="100%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="45%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="peony-blush-inner" cx="50%" cy="10%" r="100%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="45%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-600)" />
    </radialGradient>
    <!-- `blossom-petal`: radial from the petal's base (near the flower centre) outward to its
         tip — darker rose-300 base, rose-100 mid, a white-alpha rim at the tip — shared by all 5
         petals via `objectBoundingBox` units (each rotated copy has the same local bounding box). -->
    <radialGradient id="blossom-petal" cx="50%" cy="92%" r="95%">
      <stop offset="0%" style="stop-color: var(--c-rose-400)" />
      <stop offset="55%" style="stop-color: var(--c-rose-200)" />
      <stop offset="100%" style="stop-color: var(--c-rose-100)" />
    </radialGradient>
    <radialGradient id="blossom-center" cx="50%" cy="35%" r="65%">
      <stop offset="0%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>
    <!-- Natural foliage: eucalyptus and olive leaves read as lit round/lanceolate foliage (a radial
         or linear tint from a lightened champagne core out to the deep leaf tone) rather than one
         flat silhouette colour. Gold leaves get their own diagonal foil-sheen gradient (D3). -->
    <radialGradient id="leaf-eucalyptus-gradient" cx="35%" cy="28%" r="78%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="45%" style="stop-color: var(--c-leaf)" />
      <stop offset="100%" style="stop-color: var(--c-leaf-deep)" />
    </radialGradient>
    <linearGradient id="leaf-olive-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-leaf)" />
      <stop offset="100%" style="stop-color: var(--c-leaf-deep)" />
    </linearGradient>
    <linearGradient id="leaf-gold-metal" x1="15%" y1="0%" x2="85%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="35%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="70%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-700)" />
    </linearGradient>
  </defs>

  <symbol id="balloon-gloss" viewBox="0 0 100 110">
    <path d="M18 36C17 30 17 26 20 22C26 12 37 7 49 7C45 11 41 17 39 25C32 26 25 30 18 36Z" fill="url(#balloon-gloss-window)" />
    <ellipse cx="29" cy="19" rx="5" ry="3.6" fill="url(#balloon-gloss-spec)" transform="rotate(-30 29 19)" style="opacity: var(--balloon-spec, 1)" />
    <path d="M91 40C92 60 83 78 64 89C77 77 85 60 86 42C87.5 41 89.5 40.5 91 40Z" fill="url(#balloon-gloss-rim)" />
    <path d="M14 62C22 80 36 90 50 91.5C64 90 78 80 86 62C78 78 64 87 50 87.5C36 87 22 78 14 62Z" fill="url(#balloon-gloss-ao)" />
  </symbol>

  <symbol id="balloon-pink" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-pink-gradient)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-env-tint)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-pink-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" style="--balloon-spec: 0.8" />
  </symbol>

  <symbol id="balloon-rosegold" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-rosegold-gradient)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-env-tint)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-nacre)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-rosegold-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" style="--balloon-spec: 0.5" />
  </symbol>

  <symbol id="balloon-rosegold-satin" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-rosegold-satin-gradient)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-env-tint)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-nacre)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-rosegold-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" style="--balloon-spec: 0.5" />
  </symbol>

  <symbol id="balloon-champagne" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-champagne-gradient)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-env-tint)" />
    <path d="M8 56C30 48 70 48 92 56C90 68 84 78 78 84C64 76 36 76 22 84C16 78 10 68 8 56Z" fill="url(#balloon-champagne-horizon)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-champagne-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <symbol id="balloon-champagne-satin" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-champagne-satin-gradient)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-env-tint)" />
    <path d="M50 2C74.3 2 94 20.6 94 44C94 64.5 79.5 83.5 56.5 92.4C53 93.6 47 93.6 43.5 92.4C20.5 83.5 6 64.5 6 44C6 20.6 25.7 2 50 2Z" fill="url(#balloon-nacre)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-champagne-knot)"
    />
