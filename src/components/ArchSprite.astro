---
// Single hidden sprite sheet for every balloon/flower/leaf/sparkle shape the cover's arch draws:
// one <svg> holding the shared gradient <defs> plus the reusable <symbol> shapes that
// `BalloonArch.astro` references by id via <use>. Defining each shape exactly once here — the
// same pattern as `RoseSprite.astro` — is what keeps "no duplicate element ids" true no matter
// how many balloons/flowers/leaves a layout places.
//
// Gradient stop-colors read from theme tokens (`style="stop-color: var(--c-…)"`) rather than raw
// hex, so the whole sprite re-themes from the palette alone. No SVG filters
// (feGaussianBlur/feTurbulence): those rasterize per visible instance on iPhone WebKit during
// scroll/animation — the glossy-balloon read comes entirely from layered radial gradients plus a
// shared highlight shape instead.
---

<svg
  class="arch-sprite"
  data-testid="arch-sprite"
  aria-hidden="true"
  focusable="false"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  <defs>
    <!-- Balloon body gradients: every tone is >= 6 stops — hot core, light, mid body, body,
         terminator (darkest, ~85-90%) then a lighter rim stop at 100% — the terminator/rim pair
         is what reads as a lit sphere instead of a flat shaded disc. Chrome tones (rose-gold,
         champagne) keep a sharp, late terminator; their satin siblings widen the stop spacing and
         soften the terminator (no hard rose-600/champagne-700 edge) for a duller, non-mirror finish. -->
    <radialGradient id="balloon-pink-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-white)" />
      <stop offset="22%" style="stop-color: var(--c-rose-100)" />
      <stop offset="45%" style="stop-color: var(--c-rose-200)" />
      <stop offset="68%" style="stop-color: var(--c-rose-300)" />
      <stop offset="88%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-300)" />
    </radialGradient>
    <radialGradient id="balloon-rosegold-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="22%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="40%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="58%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="85%" style="stop-color: var(--c-rose-600)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>
    <radialGradient id="balloon-rosegold-satin-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="28%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="50%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="72%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="90%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>
    <radialGradient id="balloon-champagne-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="20%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="42%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="64%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="88%" style="stop-color: var(--c-champagne-700)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-300)" />
    </radialGradient>
    <radialGradient id="balloon-champagne-satin-gradient" cx="30%" cy="26%" r="80%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="24%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="48%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="70%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="90%" style="stop-color: var(--c-champagne-700)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>

    <!-- Shared across every tone: a soft contact shadow dropped below-right of the body (depth
         where balloons overlap each other) and a warm bottom-up environment tint (floor light
         bouncing into the lower half). One def each keeps the gradient budget low; neither reads
         as tone-specific. -->
    <radialGradient id="balloon-contact-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-rose-700)" stop-opacity="0.28" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="balloon-env-tint" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" style="stop-color: var(--c-champagne-200)" stop-opacity="0.35" />
      <stop offset="45%" style="stop-color: var(--c-champagne-200)" stop-opacity="0" />
    </linearGradient>

    <!-- Knots are tone-matched (a darker shade of the balloon's own body colour) instead of every
         tone sharing one wine-coloured triangle; chrome and satin siblings of a tone share a def. -->
    <linearGradient id="balloon-pink-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-rose-600)" />
      <stop offset="100%" style="stop-color: var(--c-rose-700)" />
    </linearGradient>
    <linearGradient id="balloon-rosegold-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-rosegold-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-600)" />
    </linearGradient>
    <linearGradient id="balloon-champagne-knot" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-700)" />
    </linearGradient>

    <!-- Chrome-only reflection band: a soft horizon-shaped highlight that hugs the body's own
         curvature (an elliptical arc, not an arbitrary blob) and fades to 0 opacity at both ends
         and low peak opacity throughout — a gentle sheen, not a hard "liquid line" stripe. Mirror
         finishes reflect a horizon; satin balloons skip this entirely. -->
    <linearGradient id="balloon-rosegold-chrome-band" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color: var(--c-rosegold-200)" stop-opacity="0" />
      <stop offset="24%" style="stop-color: var(--c-rosegold-200)" stop-opacity="0.3" />
      <stop offset="50%" style="stop-color: var(--c-rose-400)" stop-opacity="0.22" />
      <stop offset="76%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.3" />
      <stop offset="100%" style="stop-color: var(--c-champagne-100)" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="balloon-champagne-chrome-band" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" stop-opacity="0" />
      <stop offset="24%" style="stop-color: var(--c-champagne-200)" stop-opacity="0.3" />
      <stop offset="50%" style="stop-color: var(--c-champagne-500)" stop-opacity="0.22" />
      <stop offset="76%" style="stop-color: var(--c-champagne-100)" stop-opacity="0.3" />
      <stop offset="100%" style="stop-color: var(--c-champagne-100)" stop-opacity="0" />
    </linearGradient>

    <!-- Shared gloss (see the `balloon-gloss` symbol below): a soft broad highlight, a tight
         specular hot spot and a faint secondary "window" reflection, each its own gradient so the
         falloff for each can differ (the specular spot is small and sharp, the other two wide and
         soft). -->
    <radialGradient id="balloon-gloss-soft" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-white)" stop-opacity="0.85" />
      <stop offset="100%" style="stop-color: var(--c-white)" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="balloon-gloss-spec" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-white)" stop-opacity="1" />
      <stop offset="45%" style="stop-color: var(--c-white)" stop-opacity="0.5" />
      <stop offset="100%" style="stop-color: var(--c-white)" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="balloon-gloss-secondary" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--c-white)" stop-opacity="0.35" />
      <stop offset="100%" style="stop-color: var(--c-white)" stop-opacity="0" />
    </radialGradient>
    <!-- Rose rings (rose-pink and rose-cream): one radial gradient per ring (outer/mid/inner),
         `objectBoundingBox` units (the default — no `gradientUnits` attr) so the SAME stop recipe
         gives every petal its own light-rim -> deep-base shading regardless of which way it's
         rotated: a gradient's percentages map to that single path's own bounding box, computed
         before its `transform="rotate(… 32 32)"` is applied, not to the flower as a whole. `cy`
         sits high in the box (petals point tip-up, base-down) so the lightest stop lands at the
         curled tip and the darkest at the base, closest to the flower's center. -->
    <radialGradient id="rose-pink-outer" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="50%" style="stop-color: var(--c-rose-200)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="rose-pink-mid" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-rose-200)" />
      <stop offset="50%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="rose-pink-inner" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-rose-300)" />
      <stop offset="50%" style="stop-color: var(--c-rose-400)" />
      <stop offset="100%" style="stop-color: var(--c-rose-600)" />
    </radialGradient>
    <radialGradient id="rose-cream-outer" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-champagne-100)" />
      <stop offset="50%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>
    <radialGradient id="rose-cream-mid" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-champagne-200)" />
      <stop offset="50%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="100%" style="stop-color: var(--c-champagne-500)" />
    </radialGradient>
    <radialGradient id="rose-cream-inner" cx="50%" cy="15%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-champagne-300)" />
      <stop offset="50%" style="stop-color: var(--c-champagne-500)" />
      <stop offset="100%" style="stop-color: var(--c-rosegold-400)" />
    </radialGradient>

    <!-- Peony rings: only two gradients for three rings (outer and mid share one — a peony's
         ruffle reads from petal *count* and overlap, not a third tone step) plus a deeper inner
         ring gradient so the furled center still reads darker than the outer ruffle. -->
    <radialGradient id="peony-blush-outer" cx="50%" cy="20%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="50%" style="stop-color: var(--c-rose-200)" />
      <stop offset="100%" style="stop-color: var(--c-rose-300)" />
    </radialGradient>
    <radialGradient id="peony-blush-inner" cx="50%" cy="20%" r="90%">
      <stop offset="0%" style="stop-color: var(--c-rosegold-200)" />
      <stop offset="50%" style="stop-color: var(--c-rose-300)" />
      <stop offset="100%" style="stop-color: var(--c-rose-400)" />
    </radialGradient>
    <radialGradient id="blossom-gradient" cx="50%" cy="40%" r="70%">
      <stop offset="0%" style="stop-color: var(--c-rose-100)" />
      <stop offset="100%" style="stop-color: var(--c-rose-300)" />
    </radialGradient>
    <linearGradient id="leaf-eucalyptus-gradient" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" style="stop-color: var(--c-leaf)" />
      <stop offset="100%" style="stop-color: var(--c-leaf-deep)" />
    </linearGradient>
  </defs>

  <!-- Shared gloss overlay for every balloon tone: a soft broad highlight, a tight specular hot
       spot, a faint lower-right "window" reflection and a thin rim-light arc — drawn once,
       referenced by each balloon symbol. -->
  <symbol id="balloon-gloss" viewBox="0 0 100 110">
    <ellipse cx="34" cy="30" rx="18" ry="13" fill="url(#balloon-gloss-soft)" transform="rotate(-18 34 30)" />
    <ellipse cx="29" cy="23" rx="6" ry="5" fill="url(#balloon-gloss-spec)" />
    <path d="M69 60c9 6 11 18 4 28c5-11 3-21-4-28Z" fill="url(#balloon-gloss-secondary)" />
    <path
      d="M70 68a24 24 0 0 1 -10 16"
      fill="none"
      stroke="var(--c-white)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-opacity="0.3"
    />
  </symbol>

  <symbol id="balloon-pink" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-pink-gradient)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-env-tint)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-pink-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <symbol id="balloon-rosegold" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-rosegold-gradient)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-env-tint)" />
    <path
      d="M18 75.6A40 46 0 0 1 82 75.6L82 68.5A38 38 0 0 0 18 68.5Z"
      fill="url(#balloon-rosegold-chrome-band)"
    />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-rosegold-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <symbol id="balloon-rosegold-satin" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-rosegold-satin-gradient)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-env-tint)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-rosegold-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <symbol id="balloon-champagne" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-champagne-gradient)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-env-tint)" />
    <path
      d="M18 75.6A40 46 0 0 1 82 75.6L82 68.5A38 38 0 0 0 18 68.5Z"
      fill="url(#balloon-champagne-chrome-band)"
    />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-champagne-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <symbol id="balloon-champagne-satin" viewBox="0 0 100 110">
    <ellipse cx="58" cy="92" rx="20" ry="7" fill="url(#balloon-contact-shadow)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-champagne-satin-gradient)" />
    <ellipse cx="50" cy="48" rx="44" ry="46" fill="url(#balloon-env-tint)" />
    <path
      d="M50 92.8C52.6 93 53.75 95.2 52.6 97.3C51.7 99 48.3 99 47.4 97.3C46.25 95.2 47.4 93 50 92.8Z"
      fill="url(#balloon-champagne-knot)"
    />
    <ellipse cx="48.4" cy="93.8" rx="0.9" ry="0.5" fill="var(--c-white)" fill-opacity="0.5" transform="rotate(-20 48.4 93.8)" />
    <use href="#balloon-gloss" />
  </symbol>

  <!-- `rose-pink` and `rose-cream` share the same petal paths (the two rose tones are the same
       flower in different light) in three rings — 5 outer cupped petals, 4 middle, 3 inner —
       rotated with `transform="rotate(… 32 32)"` around the flower's own center so each ring's one
       gradient def paints every petal in it. A swirled center bud (solid darkest token, no
       gradient) reads as the furled spiral a real rose hides at its heart, and a thin multi-subpath
       stroke traces a curl-highlight along a few petal rims for the "lit edge" the flat version
       (one same-shade blob per ring) was missing. -->
  <symbol id="rose-pink" viewBox="0 0 64 64">
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-pink-outer)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-pink-outer)" transform="rotate(72 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-pink-outer)" transform="rotate(144 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-pink-outer)" transform="rotate(216 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-pink-outer)" transform="rotate(288 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-pink-mid)" transform="rotate(36 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-pink-mid)" transform="rotate(126 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-pink-mid)" transform="rotate(216 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-pink-mid)" transform="rotate(306 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-pink-inner)" transform="rotate(60 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-pink-inner)" transform="rotate(180 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-pink-inner)" transform="rotate(300 32 32)" />
    <path d="M32 26c3 0 6 2 6 6c0 3-2 6-6 6c-3 0-5-2-5-5c0-2 1-4 3-4c1 0 2 1 2 2" fill="var(--c-rose-600)" />
    <path
      d="M22 14Q27 9 32 10M32 10Q37 9 42 14M16 28Q19 21 24 17"
      fill="none"
      stroke="var(--c-white)"
      stroke-width="1"
      stroke-opacity="0.5"
      stroke-linecap="round"
    />
  </symbol>

  <symbol id="rose-cream" viewBox="0 0 64 64">
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-cream-outer)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-cream-outer)" transform="rotate(72 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-cream-outer)" transform="rotate(144 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-cream-outer)" transform="rotate(216 32 32)" />
    <path d="M32 32C25 29 22 18 27 9C29 6 35 6 37 9C42 18 39 29 32 32Z" fill="url(#rose-cream-outer)" transform="rotate(288 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-cream-mid)" transform="rotate(36 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-cream-mid)" transform="rotate(126 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-cream-mid)" transform="rotate(216 32 32)" />
    <path d="M32 32C27 30 25 22 28 15C29 13 35 13 36 15C39 22 37 30 32 32Z" fill="url(#rose-cream-mid)" transform="rotate(306 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-cream-inner)" transform="rotate(60 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-cream-inner)" transform="rotate(180 32 32)" />
    <path d="M32 32C29 30 27 25 29 20C29.5 18.5 34.5 18.5 35 20C37 25 35 30 32 32Z" fill="url(#rose-cream-inner)" transform="rotate(300 32 32)" />
    <path d="M32 26c3 0 6 2 6 6c0 3-2 6-6 6c-3 0-5-2-5-5c0-2 1-4 3-4c1 0 2 1 2 2" fill="var(--c-champagne-700)" />
    <path
      d="M22 14Q27 9 32 10M32 10Q37 9 42 14M16 28Q19 21 24 17"
      fill="none"
      stroke="var(--c-white)"
      stroke-width="1"
      stroke-opacity="0.5"
      stroke-linecap="round"
    />
  </symbol>

  <!-- `peony-blush`: a fuller, ruffled bloom — 3 rings of scalloped (double-lobed tip) petals, 16
       in all, outer and mid sharing one gradient (a peony's ruffle reads from petal count and
       overlap, not a third tone step) with a deeper inner-ring gradient so the furled center still
