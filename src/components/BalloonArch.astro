---
// Decorative balloon-and-flower garland that frames the cover: two hand-composed layouts
// (portrait vs landscape, see src/lib/cover-garland.ts) rendered as SVG in their authored paint
// order, with only one shown at a time via an aspect-ratio media query below. Every item is a
// <use> of a symbol defined once in ArchSprite.astro. Purely decorative — aria-hidden and
// pointer-events: none — so it carries no accessible content and never intercepts clicks on the
// title/button it sits above.
import { GARLAND, garlandFadeMask, kindOf } from '../lib/cover-garland';

const layoutNames = ['portrait', 'landscape'] as const;
// Width per unit of crown height, so the portrait floor below can size the SVG from a crown height.
const portraitAspect = GARLAND.portrait.width / GARLAND.portrait.clear.top;
---

<div
  class="balloon-arch"
  data-testid="balloon-arch"
  aria-hidden="true"
  style={`--garland-portrait-aspect:${portraitAspect}`}
>
  <div class="balloon-arch__shadow" data-testid="balloon-arch-shadow">
    {
      layoutNames.map((name) => {
        const layout = GARLAND[name];
        const mask = garlandFadeMask(layout);
        return (
          <svg
            class="balloon-arch__layout"
            data-arch-layout={name}
            viewBox={`0 0 ${layout.width} ${layout.height}`}
            style={`mask-image:${mask};-webkit-mask-image:${mask}`}
          >
            {layout.items.map((item) => (
              <use
                href={`#${item.symbol}`}
                data-arch-item={kindOf(item.symbol)}
                data-arch-symbol={item.symbol}
                data-garland-depth={item.depth}
                x={item.x - item.size / 2}
                y={item.y - item.size / 2}
                width={item.size}
                height={item.size}
                transform={`rotate(${item.rotate} ${item.x} ${item.y})`}
              />
            ))}
          </svg>
        );
      })
    }
  </div>
</div>

<style>
  .balloon-arch {
    position: absolute;
    /* Bounded to the cover's own box on every edge (not just top/left/right) and clipped: with no
       frame to clip to, a layout taller than the cover (e.g. a deep portrait arch on a short,
       wide viewport) would otherwise spill past the cover's bottom edge into the section below
       it. The soft-end mask keeps that clip from reading as a hard cut. */
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, var(--c-white) calc(100% - 10vh), transparent 100%);
    -webkit-mask-image: linear-gradient(
      to bottom,
      var(--c-white) calc(100% - 10vh),
      transparent 100%
    );
  }

  /* The one arch-wide drop-shadow (depth for the arch as a whole, no per-item filters). Lives on
     its own wrapper rather than `.balloon-arch` itself, matching the per-item symbol layout. */
  .balloon-arch__shadow {
    filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--c-rose-700) 16%, transparent));
  }

  .balloon-arch__layout {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  /* Tall phones: a width-scaled crown would leave an empty gap, so the crown never ends above 36vh.
     The SVG keeps its aspect ratio and grows past both sides, cropped symmetrically, which only
     pushes the corner items further out of the text zone. */
  .balloon-arch__layout[data-arch-layout='portrait'] {
    width: max(100%, calc(36vh * var(--garland-portrait-aspect)));
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .balloon-arch__layout[data-arch-layout='landscape'] {
    display: none;
  }

  @media (min-aspect-ratio: 1/1) {
    .balloon-arch__layout[data-arch-layout='portrait'] {
      display: none;
    }

    .balloon-arch__layout[data-arch-layout='landscape'] {
      display: block;
    }
  }
</style>
