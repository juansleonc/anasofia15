---
// Decorative balloon-and-flower arch that frames the cover: two independently generated layouts
// (portrait vs landscape, see src/lib/cover-arch.ts) rendered as SVG, with only one shown at a
// time via an aspect-ratio media query below. Every item is a <use> of a symbol defined once in
// ArchSprite.astro. Purely decorative — aria-hidden and pointer-events: none — so it carries no
// accessible content and never intercepts clicks on the title/button it sits above.
import { ARCH_SPECS, archFadeMask, buildArch, type ArchLayout } from '../lib/cover-arch';

const layouts: { name: 'portrait' | 'landscape'; layout: ArchLayout; mask: string }[] = [
  { name: 'portrait', layout: buildArch(ARCH_SPECS.portrait), mask: archFadeMask(ARCH_SPECS.portrait) },
  { name: 'landscape', layout: buildArch(ARCH_SPECS.landscape), mask: archFadeMask(ARCH_SPECS.landscape) },
];
---

<div class="balloon-arch" data-testid="balloon-arch" aria-hidden="true">
  <div class="balloon-arch__shadow" data-testid="balloon-arch-shadow">
    {
      layouts.map(({ name, layout, mask }) => (
        <svg
          class="balloon-arch__layout"
          data-arch-layout={name}
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          style={`mask-image:${mask};-webkit-mask-image:${mask}`}
        >
          {layout.items.map((item) => (
            <use
              href={`#${item.symbol}`}
              data-arch-item={item.kind}
              data-arch-symbol={item.symbol}
              x={item.x - item.size / 2}
              y={item.y - item.size / 2}
              width={item.size}
              height={item.size}
              transform={`rotate(${item.rotate} ${item.x} ${item.y})`}
            />
          ))}
        </svg>
      ))
    }
  </div>
</div>

<style>
  .balloon-arch {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 0;
    pointer-events: none;
  }

  /* The one arch-wide drop-shadow (depth for the arch as a whole, no per-item filters). Lives on
     its own wrapper rather than `.balloon-arch` itself, matching the per-item symbol layout. */
  .balloon-arch__shadow {
    filter: drop-shadow(0 6px 10px color-mix(in srgb, var(--c-rose-700) 16%, transparent));
  }

  .balloon-arch__layout {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .balloon-arch__layout[data-arch-layout='landscape'] {
    display: none;
  }

  @media (min-aspect-ratio: 1/1) {
    .balloon-arch__layout[data-arch-layout='portrait'] {
      display: none;
    }

    .balloon-arch__layout[data-arch-layout='landscape'] {
      display: block;
    }
  }
</style>
