---
// The "Los detalles" / "La noche" vertical timeline: Cuándo / Dónde / Código de vestimenta / La fiesta,
// all sourced from src/data/event.ts's `timeline` array — this file only renders, it never
// authors copy.
import { event } from '../data/event';
import EyebrowEmoji from '../components/EyebrowEmoji.astro';
---

<section class="detalles" data-testid="detalles" aria-label="Los detalles">
  <div class="detalles__header">
    <p class="detalles__eyebrow"><EyebrowEmoji emoji="✨" />Los detalles</p>
    <h2 class="detalles__title text-rose">La celebración</h2>
  </div>

  <ol class="detalles__timeline">
    {
      event.timeline.map((item) => (
        <li class="detalles__item" data-testid="detalles-item">
          <p class="detalles__tag">{item.tag}</p>
          <p class="detalles__item-title">{item.title}</p>
          {item.description && <p class="detalles__item-desc">{item.description}</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .detalles {
    padding: 3.75rem 1rem 2.5rem;
  }

  .detalles__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .detalles__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--c-rose-700);
  }

  .detalles__title {
    font-weight: 700;
    font-size: clamp(1.875rem, 8vw, 3rem);
    margin-top: 0.75rem;
  }

  .detalles__timeline {
    position: relative;
    max-width: 34rem;
    margin: 0 auto;
    padding-left: 2.125rem;
    list-style: none;
  }

  .detalles__timeline::before {
    content: '';
    position: absolute;
    left: 0.5625rem;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      var(--c-rose-400) 12%,
      var(--c-rose-400) 88%,
      transparent
    );
  }

  .detalles__item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .detalles__item:last-child {
    padding-bottom: 0;
  }

  .detalles__item::before {
    content: '';
    position: absolute;
    left: -1.875rem;
    top: 0.25rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--c-rose-100), var(--c-rose-700));
    box-shadow:
      0 0 0 4px var(--c-bg),
      0 0 14px color-mix(in srgb, var(--c-rose-400) 60%, transparent);
  }

  .detalles__tag {
    font-size: 0.6875rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--c-rose-700);
  }

  .detalles__item-title {
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--c-ink);
    margin: 0.5rem 0 0.375rem;
  }

  .detalles__item-desc {
    font-weight: 300;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--c-ink-soft);
    opacity: 0.9;
  }
</style>
