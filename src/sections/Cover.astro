---
// Landing screen; the "Abrir invitación" button is the only way past the cover (scroll is locked
// until it's clicked — see the script below). The click also dispatches `OPEN_INVITATION_EVENT`
// on `window`, which `islands/MusicToggle.astro` listens for to start playback — a loose
// window-event handshake so neither file needs to import or duplicate the other's audio element.
import BalloonArch from '../components/BalloonArch.astro';
import CoverSparkles from '../components/CoverSparkles.astro';
import PetalFall from '../islands/PetalFall.astro';
import { event } from '../data/event';
import { archClearanceVars, ARCH_SPECS } from '../lib/cover-arch';
---

<section
  class="cover"
  data-testid="cover"
  aria-label="Portada de la invitación"
  style={archClearanceVars(ARCH_SPECS)}
>
  <div class="cover__light" data-testid="cover-light" aria-hidden="true"></div>
  <BalloonArch />
  <CoverSparkles />
  <div class="cover__content">
    <div class="cover__glow" data-testid="cover-glow" aria-hidden="true"></div>
    <h1 class="cover__title">
      <span class="cover__title-lead" data-testid="cover-title-lead">Invitación para los quince años de</span>{' '}
      <span class="cover__title-name font-cursive" data-testid="cover-celebrant-name">
        {event.celebrantName}
      </span>
    </h1>
    <button type="button" tabindex="0" class="cover__open-button" data-testid="open-invitation-button">
      Abrir invitación
    </button>
  </div>
  <PetalFall />
</section>

<style>
  .cover {
    position: relative;
    /* border-box so `min-height: 100dvh` caps the TOTAL box at one viewport; with the default
       content-box it only bounded the area inside the padding, leaving the guest's scroll-locked
       first screen taller than the viewport. */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vh, 2.25rem);
    min-height: 100dvh;
    padding: clamp(3.75rem, 14vh, 6rem) 1.25rem;
    /* Never let the title sit under the arch: clear at least as far down as the arch's crown
       band reaches (see archClearanceVars in cover-arch.ts), whichever is taller than the
       cosmetic clamp above. */
    padding-top: max(clamp(3.75rem, 14vh, 6rem), calc(var(--arch-band-portrait) * 100%));
    text-align: center;
    isolation: isolate;
    /* Depth behind the whole cover: a soft vignette (draws the eye to the centre) over a vertical
       champagne-to-rose wash (reads as light falling from above), both static. */
    background-image:
      radial-gradient(
        ellipse 120% 90% at 50% 42%,
        transparent 58%,
        color-mix(in srgb, var(--c-rose-300) 26%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        var(--c-champagne-100) 0%,
        var(--c-bg) 34%,
        var(--c-rose-100) 72%,
        color-mix(in srgb, var(--c-rose-200) 70%, var(--c-bg)) 100%
      );
  }

  /* Warm ambient light behind the arch: a golden haze plus very subtle rays. No frame to clip to
     anymore — `inset: 0` already bounds it to the cover's own box, same as before. Static — no
     animation, so it needs no reduced-motion handling. */
  .cover__light {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        ellipse 70% 45% at 50% 30%,
        color-mix(in srgb, var(--c-champagne-200) 45%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 30% 20% at 12% 85%,
        color-mix(in srgb, var(--c-champagne-100) 50%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 30% 20% at 88% 85%,
        color-mix(in srgb, var(--c-champagne-100) 50%, transparent),
        transparent 70%
      ),
      conic-gradient(
        from 160deg at 50% -8%,
        transparent,
        color-mix(in srgb, var(--c-champagne-100) 20%, transparent) 4deg,
        transparent 9deg,
        transparent 50deg,
        color-mix(in srgb, var(--c-champagne-100) 16%, transparent) 54deg,
        transparent 59deg,
        transparent 100deg,
        color-mix(in srgb, var(--c-champagne-100) 18%, transparent) 104deg,
        transparent 109deg,
        transparent 151deg,
        color-mix(in srgb, var(--c-champagne-100) 16%, transparent) 155deg,
        transparent 160deg,
        transparent 200deg,
        color-mix(in srgb, var(--c-champagne-100) 18%, transparent) 204deg,
        transparent 209deg
      );
    mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, var(--c-white), transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, var(--c-white), transparent 75%);
  }

  @media (min-aspect-ratio: 1/1) {
    .cover {
      padding-top: max(clamp(3.75rem, 14vh, 6rem), calc(var(--arch-band-landscape) * 100%));
    }
  }

  .cover__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 4vh, 2.25rem);
  }

  /* Warm light cast directly behind the lead line, the name and the button — raises (never
     lowers) text contrast rather than competing with it (D5). Sits in the content's own stacking
     context so it never leaks in front of or behind the arch/frame. */
  .cover__glow {
    position: absolute;
    inset: -8% -5%;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(
      ellipse at 50% 48%,
      color-mix(in srgb, var(--c-champagne-100) 92%, transparent) 0%,
      color-mix(in srgb, var(--c-champagne-200) 40%, transparent) 45%,
      transparent 72%
    );
  }

  .cover__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    max-width: 26rem;
  }

  .cover__title-lead {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4vw, 1.4rem);
    font-weight: 600;
    font-style: italic;
    color: var(--c-ink);
    letter-spacing: 0.01em;
  }

  .cover__title-name {
    display: inline-block;
    font-size: clamp(3.2rem, 15vw, 5.25rem);
    line-height: 1.3;
    padding: 0.1em 0.2em;
    color: var(--c-rose-700);
  }

  .cover__open-button {
    margin-top: 0.25rem;
    padding: 1rem 2.625rem;
    border: 2px solid var(--c-champagne-500);
    border-radius: 999px;
    /* Sheen first so it paints over the wine gradient underneath (both wine stops stay in the
       computed `background-image`, just with a translucent highlight laid on top). */
    background: var(--gradient-button-sheen), var(--gradient-button-wine);
    /* Relief stack, named so the pulse keyframes below can reuse it instead of repeating it:
       bevel highlight (top inset), inner shadow (bottom inset, gives the pill its "pressed-in"
       depth), a gold outer ring (double rim with the solid border), a tight contact shadow, a
       soft lift shadow, and the pre-existing long soft shadow token. */
    --cover-button-shadow: inset 0 1px 0 color-mix(in srgb, var(--c-champagne-100) 60%, transparent),
      inset 0 -3px 6px color-mix(in srgb, var(--c-wine-700) 75%, var(--c-ink)),
      0 0 0 1px color-mix(in srgb, var(--c-champagne-300) 70%, transparent),
      0 2px 3px color-mix(in srgb, var(--c-wine-700) 35%, transparent),
      0 10px 22px -10px color-mix(in srgb, var(--c-wine-700) 45%, transparent), var(--shadow-button-wine);
    box-shadow: var(--cover-button-shadow);
    color: var(--c-white);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-family: var(--font-display);
    /* Engraved look: only darkens around the glyphs, never lightens them. */
    text-shadow: 0 1px 1px color-mix(in srgb, var(--c-wine-700) 70%, transparent);
    cursor: pointer;
    transition: transform var(--motion-duration-base) var(--motion-easing);
    animation: cover-pulse 2.6s ease-out infinite;
  }

  .cover__open-button:hover {
    transform: translateY(-2px);
  }

  .cover__open-button:focus-visible {
    outline: 2px solid var(--c-champagne-500);
    outline-offset: 3px;
  }

  /* The relief responds to touch: the pill presses in and its inner shadow deepens. */
  .cover__open-button:active {
    transform: translateY(1px);
    --cover-button-shadow: inset 0 1px 0 color-mix(in srgb, var(--c-champagne-100) 60%, transparent),
      inset 0 -5px 9px color-mix(in srgb, var(--c-wine-700) 85%, var(--c-ink)),
      0 0 0 1px color-mix(in srgb, var(--c-champagne-300) 70%, transparent),
      0 1px 2px color-mix(in srgb, var(--c-wine-700) 35%, transparent), var(--shadow-button-wine);
  }

  /* Soft expanding champagne-gold ring, layered on top of the resting shadow so the shadow never
     blinks off. */
  @keyframes cover-pulse {
    0%,
    100% {
      box-shadow:
        var(--cover-button-shadow),
        0 0 0 0 color-mix(in srgb, var(--c-champagne-500) 45%, transparent);
    }
    70% {
      box-shadow:
        var(--cover-button-shadow),
        0 0 0 16px color-mix(in srgb, var(--c-champagne-500) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__open-button {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { OPEN_INVITATION_EVENT } from '../lib/events';

  const SCROLL_LOCK_CLASS = 'scroll-locked';

  // Gate the whole page behind the "Abrir invitación" click: lock scroll immediately (JS-only —
  // see tokens.css's `.scroll-locked` rule for why a JS failure never leaves the page stuck).
  document.body.classList.add(SCROLL_LOCK_CLASS);

  const openButton = document.querySelector(
    '[data-testid="open-invitation-button"]',
  ) as HTMLButtonElement | null;

  openButton?.addEventListener('click', () => {
    // Unlock BEFORE the programmatic scroll below — scrolling a locked root is a no-op.
    document.body.classList.remove(SCROLL_LOCK_CLASS);

    window.dispatchEvent(new CustomEvent(OPEN_INVITATION_EVENT));

    // "Opening" must be visible, not just audible: glide down to the countdown, which now sits
    // right after the cover. Guests who prefer reduced motion jump there instantly instead of
    // animating the scroll.
    const countdown = document.querySelector('[data-testid="countdown"]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    countdown?.scrollIntoView({
      behavior: prefersReducedMotion ? 'auto' : 'smooth',
      block: 'start',
    });
  });
</script>
