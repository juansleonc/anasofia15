---
// Landing screen; the "Abrir invitación" button is the only way past the cover (scroll is locked
// until it's clicked — see the script below). The click also dispatches `OPEN_INVITATION_EVENT`
// on `window`, which `islands/MusicToggle.astro` listens for to start playback — a loose
// window-event handshake so neither file needs to import or duplicate the other's audio element.
import BalloonArch from '../components/BalloonArch.astro';
import CoverLowerGlitter from '../components/CoverLowerGlitter.astro';
import CoverSparkles from '../components/CoverSparkles.astro';
import PetalFall from '../islands/PetalFall.astro';
import { event } from '../data/event';
import { archClearanceVars, ARCH_SPECS } from '../lib/cover-arch';
import { ringSparkles } from '../lib/sparkles';

// Nov 2026 user-feedback pass: "mucho espacio vacío en el centro" — the arch is getting airier in
// a parallel task, so the cover's own centre needed more presence (bigger type, a flourish and a
// tight ring of sparkles around the title), not more clutter. This small ring is deliberately
// separate from CoverSparkles's whole-cover `scatterSparkles` layer (see src/lib/sparkles.ts) —
// it's positioned relative to the title block itself (see `.cover__title { position: relative }`
// below), not scattered across the whole cover, so it reads as a halo around the name specifically.
const TITLE_RING_COUNT = 5;
const TITLE_RING_SEED = 4015;
const titleRingSparkles = ringSparkles({ count: TITLE_RING_COUNT, seed: TITLE_RING_SEED });

// The title's own max-width must never let it grow wider than the arch's text clear zone (the
// full-width strip between the two side gutter columns — see clampOutOfClearZone in cover-arch.ts)
// or a single-line lead/name can grow into the side balloons at some in-between viewport width.
// Derived straight from the same ARCH_SPECS the arch itself is built from (read-only — this never
// touches cover-arch.ts), as a fraction of the viewport width, the same way archClearanceVars
// derives the vertical clearance.

// A rotated/elongated balloon's rendered bounding box can bleed a few px past the strict circular
// clear-zone math clampOutOfClearZone uses, so this leaves a safety margin rather than sizing the
// title to exactly touch the theoretical boundary.
const TEXT_CLEAR_SAFETY_FACTOR = 0.9;

function clearWidthRatio(spec: (typeof ARCH_SPECS)['portrait']): number {
  return (1 - (2 * spec.gutter) / spec.width) * TEXT_CLEAR_SAFETY_FACTOR;
}
const archClearWidthVars =
  `--arch-clear-portrait:${clearWidthRatio(ARCH_SPECS.portrait)};` +
  `--arch-clear-landscape:${clearWidthRatio(ARCH_SPECS.landscape)};`;

// Nov 2026 user-feedback pass: the name must render on a single line at every viewport (see
// `white-space: nowrap` on .cover__title-name below), never wrapping onto two lines the way a
// plain vw clamp could. So its font-size can't be tuned independently of the space it has to
// fit in — it has to be derived straight from the same clear-zone width as `.cover__title`'s own
// max-width above. `NAME_WIDTH_PER_EM` is how wide one rendered px of `event.celebrantName`'s own
// box (text plus its 0.2em-per-side horizontal padding, see .cover__title-name) is per 1px of
// font-size — measured directly off the live Great Vibes render, so it's tied to this specific
// string; re-measure it if the celebrant name ever changes. `NAME_FIT_SAFETY` keeps the computed
// size a little under the exact fit so antialiasing/sub-pixel rounding never tips it into
// overflowing the clear zone.
const NAME_WIDTH_PER_EM = 4.224;
const NAME_FIT_SAFETY = 0.93;
const nameFitVar = `--name-fit-ratio:${(NAME_FIT_SAFETY / NAME_WIDTH_PER_EM).toFixed(4)};`;
---

<section
  class="cover"
  data-testid="cover"
  aria-label="Portada de la invitación"
  style={`${archClearanceVars(ARCH_SPECS)};${archClearWidthVars}${nameFitVar}`}
>
  <div class="cover__light" data-testid="cover-light" aria-hidden="true"></div>
  <BalloonArch />
  <CoverSparkles />
  <CoverLowerGlitter />
  <div class="cover__content">
    <div class="cover__glow" data-testid="cover-glow" aria-hidden="true"></div>
    <h1 class="cover__title">
      <span class="cover__title-lead" data-testid="cover-title-lead">Invitación para los quince años de</span>{' '}
      <span class="cover__title-name font-cursive" data-testid="cover-celebrant-name">
        {event.celebrantName}
      </span>
      <div class="cover__title-sparkles" data-testid="cover-title-sparkles" aria-hidden="true">
        {
          titleRingSparkles.map((sparkle) => {
            const vars =
              `--sparkle-x:${sparkle.xPct}%;` +
              `--sparkle-y:${sparkle.yPct}%;` +
              `--sparkle-size:${sparkle.sizePx}px;` +
              `--sparkle-rotate:${sparkle.rotateDeg}deg;` +
              `--sparkle-delay:${sparkle.delayMs}ms;` +
              `--sparkle-duration:${sparkle.durationMs}ms;`;

            if (sparkle.kind === 'star') {
              return (
                <span
                  class="cover-title-sparkle__item cover-title-sparkle__star"
                  data-title-sparkle="star"
                  style={`${vars}--sparkle-tone:var(--c-champagne-200);`}
                >
                  <span class="cover-title-sparkle__halo" />
                  <svg viewBox="0 0 24 24" width="100%" height="100%">
                    <use href="#sparkle-star" />
                  </svg>
                </span>
              );
            }

            return (
              <span
                class="cover-title-sparkle__item cover-title-sparkle__glow"
                data-title-sparkle="glow"
                style={`${vars}--sparkle-tone:var(--c-white);`}
              />
            );
          })
        }
      </div>
    </h1>
    <div class="cover__flourish" data-testid="cover-flourish" aria-hidden="true">
      <span class="cover__flourish-line"></span>
      <svg class="cover__flourish-icon" viewBox="0 0 24 24">
        <use href="#sparkle-star" />
      </svg>
      <span class="cover__flourish-line"></span>
    </div>
    <button type="button" tabindex="0" class="cover__open-button" data-testid="open-invitation-button">
      Abrir invitación
    </button>
  </div>
  <PetalFall />
</section>

<style>
  .cover {
    position: relative;
    /* border-box so `min-height: 100dvh` caps the TOTAL box at one viewport; with the default
       content-box it only bounded the area inside the padding, leaving the guest's scroll-locked
       first screen taller than the viewport. */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vh, 2.25rem);
    min-height: 100dvh;
    padding: clamp(3.75rem, 14vh, 6rem) 1.25rem;
    /* Never let the title sit under the arch: clear at least as far down as the arch's crown
       band reaches (see archClearanceVars in cover-arch.ts), whichever is taller than the
       cosmetic clamp above. */
    padding-top: max(clamp(3.75rem, 14vh, 6rem), calc(var(--arch-band-portrait) * 100%));
    text-align: center;
    isolation: isolate;
    /* Depth behind the whole cover: a soft vignette (draws the eye to the centre) over a vertical
       champagne-to-rose wash (reads as light falling from above), both static. */
    background-image:
      radial-gradient(
        ellipse 120% 90% at 50% 42%,
        transparent 58%,
        color-mix(in srgb, var(--c-rose-300) 26%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        var(--c-champagne-100) 0%,
        var(--c-bg) 34%,
        var(--c-rose-100) 72%,
        color-mix(in srgb, var(--c-rose-200) 70%, var(--c-bg)) 100%
      );
  }

  /* Warm ambient light behind the arch: a golden haze plus very subtle rays. No frame to clip to
     anymore — `inset: 0` already bounds it to the cover's own box, same as before. Static — no
     animation, so it needs no reduced-motion handling. */
  .cover__light {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(
        ellipse 70% 45% at 50% 30%,
        color-mix(in srgb, var(--c-champagne-200) 45%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 30% 20% at 12% 85%,
        color-mix(in srgb, var(--c-champagne-100) 50%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 30% 20% at 88% 85%,
        color-mix(in srgb, var(--c-champagne-100) 50%, transparent),
        transparent 70%
      ),
      conic-gradient(
        from 160deg at 50% -8%,
        transparent,
        color-mix(in srgb, var(--c-champagne-100) 20%, transparent) 4deg,
        transparent 9deg,
        transparent 50deg,
        color-mix(in srgb, var(--c-champagne-100) 16%, transparent) 54deg,
        transparent 59deg,
        transparent 100deg,
        color-mix(in srgb, var(--c-champagne-100) 18%, transparent) 104deg,
        transparent 109deg,
        transparent 151deg,
        color-mix(in srgb, var(--c-champagne-100) 16%, transparent) 155deg,
        transparent 160deg,
        transparent 200deg,
        color-mix(in srgb, var(--c-champagne-100) 18%, transparent) 204deg,
        transparent 209deg
      );
    mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, var(--c-white), transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, var(--c-white), transparent 75%);
  }

  @media (min-aspect-ratio: 1/1) {
    .cover {
      padding-top: max(clamp(3.75rem, 14vh, 6rem), calc(var(--arch-band-landscape) * 100%));
    }
  }

  .cover__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Nov 2026 user-feedback pass: tightened from the previous clamp(1.25rem, 4vh, 2.25rem) so the
       (now larger) lead/name/flourish/button read as one dense, centred block instead of a loose
       stack with gaps sized for the old, smaller type. */
    gap: clamp(0.85rem, 2.5vh, 1.5rem);
  }

  /* Warm light cast directly behind the lead line, the name and the button — raises (never
     lowers) text contrast rather than competing with it (D5). Sits in the content's own stacking
     context so it never leaks in front of or behind the arch/frame. */
  .cover__glow {
    position: absolute;
    inset: -8% -5%;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(
      ellipse at 50% 48%,
      color-mix(in srgb, var(--c-champagne-100) 92%, transparent) 0%,
      color-mix(in srgb, var(--c-champagne-200) 40%, transparent) 45%,
      transparent 72%
    );
  }

  .cover__title {
    /* Positions `.cover__title-sparkles` below relative to the title's own rendered box, so the
       ring of extra sparkles always sits "around the name" regardless of viewport/text length. */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Nov 2026 user-feedback pass: tightened from 0.5rem so the lead and name read as one
       cohesive block instead of two loosely related lines (see the lead/name gap e2e test). */
    gap: 0.3rem;
    margin: 0;
    /* Never wider than the arch's own text clear zone (see archClearWidthVars above) — otherwise a
       single-line lead/name can grow past the gutter and into the side balloons at some in-between
       viewport width. `vw`-based, not a container percentage, so it resolves against the real
       viewport regardless of this flex column's own shrink-to-fit width. No longer capped at a
       flat 26rem (that cap used to force the lead to wrap earlier than it needed to on wide
       viewports, orphaning its last word) — the clear zone itself is the only limit now, and the
       name keeps clear of it on its own via its own fitted font-size below. */
    max-width: calc(var(--arch-clear-portrait) * 100vw);
  }

  @media (min-aspect-ratio: 1/1) {
    .cover__title {
      max-width: calc(var(--arch-clear-landscape) * 100vw);
    }
  }

  .cover__title-lead {
    font-family: var(--font-display);
    /* Nov 2026 user-feedback pass: floor raised from 1.05rem (the old 4vw formula clamped to a
       16.8px floor at 375px) to a 1.3rem (20.8px) floor, growing further on wide viewports. */
    font-size: clamp(1.3rem, 0.95rem + 1.1vw, 1.8rem);
    font-weight: 600;
    font-style: italic;
    color: var(--c-ink);
    letter-spacing: 0.01em;
    /* Nov 2026 user-feedback pass: lets the browser pick a more even line split (never a lone
       trailing word) instead of the greedy default — see the "no orphan last line" e2e test. */
    text-wrap: balance;
  }

  .cover__title-name {
    display: inline-block;
    /* Nov 2026 user-feedback pass: the name must always render on one line (never wrap, never
       overlap the arch) — `nowrap` plus a font-size derived from the clear-zone width itself (see
       `nameFitVar` above) instead of an independent vw clamp, which could (and did) size the name
       wider than the room it had to fit in. */
    white-space: nowrap;
    font-size: clamp(3.25rem, calc(var(--name-fit-ratio) * var(--arch-clear-portrait) * 100vw), 6.5rem);
    /* Tightened from 1.3 (and padding from 0.1em) together with .cover__title's smaller gap above,
       so the name sits close under the lead instead of leaving a large empty band between them. */
    line-height: 1.18;
    padding: 0.04em 0.2em;
    color: var(--c-rose-700);
  }

  @media (min-aspect-ratio: 1/1) {
    .cover__title-name {
      font-size: clamp(3.25rem, calc(var(--name-fit-ratio) * var(--arch-clear-landscape) * 100vw), 6.5rem);
    }
  }

  /* A small, tightly clustered ring of extra glow/star sparkles layered directly around the title
     block (see ringSparkles() in lib/sparkles.ts) — absolutely positioned so it never affects the
     title's own flex layout/height, just floats over/around it. */
  .cover__title-sparkles {
    position: absolute;
    /* Kept well inside the cover's own left/right padding (never past it, regardless of viewport —
       see cover.spec.ts's overflow tests) while still reaching generously above/below the text. */
    inset: -18% -5%;
    pointer-events: none;
  }

  .cover-title-sparkle__item {
    position: absolute;
    left: var(--sparkle-x);
    top: var(--sparkle-y);
    width: var(--sparkle-size);
    height: var(--sparkle-size);
    animation-name: cover-title-sparkle-twinkle;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-delay: var(--sparkle-delay);
    animation-duration: var(--sparkle-duration);
  }

  .cover-title-sparkle__glow {
    border-radius: 50%;
    background: radial-gradient(circle, var(--sparkle-tone) 0%, transparent 72%);
  }

  .cover-title-sparkle__star {
    transform: rotate(var(--sparkle-rotate));
  }

  .cover-title-sparkle__star svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover-title-sparkle__halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--sparkle-size) * 2.8);
    height: calc(var(--sparkle-size) * 2.8);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--sparkle-tone) 70%, transparent) 0%,
      transparent 72%
    );
  }

  /* Fainter peak than the whole-cover sparkle layer's 0.8 — "subtle", concentrated accents around
     the name, not a second layer of attention-grabbing twinkle. */
  @keyframes cover-title-sparkle-twinkle {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.65;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-title-sparkle__item {
      animation: none;
    }
  }

  /* Thin champagne divider between the name and the button: a small flourish icon (reusing the
     sparkle-star symbol) between two hairlines, fading out at both ends. */
  .cover__flourish {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 11rem;
  }

  .cover__flourish-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-champagne-500), transparent);
  }

  .cover__flourish-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
  }

  .cover__open-button {
    margin-top: 0.25rem;
    /* Floor from the Nov 2026 design-review pass: the pill read as too small for its space and the
       label was hard to read. The clamps grow both past the floor on wider viewports. */
    min-width: 240px;
    min-height: 56px;
    padding: clamp(1.1rem, 1vw + 0.85rem, 1.5rem) clamp(2.75rem, 6vw, 4rem);
    border: 2px solid var(--c-champagne-500);
    border-radius: 999px;
    /* Sheen first so it paints over the rose gradient underneath (both rose stops stay in the
       computed `background-image`, just with a translucent highlight laid on top). */
    background: var(--gradient-button-sheen), var(--gradient-button-rose);
    /* Relief stack, named so the pulse keyframes below can reuse it instead of repeating it:
       bevel highlight (top inset), inner shadow (bottom inset, gives the pill its "pressed-in"
       depth), a gold outer ring (double rim with the solid border), a tight contact shadow, a
       soft lift shadow, and the pre-existing long soft shadow token. Round-3 feedback follow-up:
       the inner shadow and contact/lift shadows used to mix in the retired dark wine token,
       keeping a wine undertone under the lighter rose fill — every layer below now stays in the
       rose + champagne family instead. */
    --cover-button-shadow: inset 0 1px 0 color-mix(in srgb, var(--c-champagne-100) 60%, transparent),
      inset 0 -3px 6px color-mix(in srgb, var(--c-rose-700) 65%, var(--c-ink)),
      0 0 0 1px color-mix(in srgb, var(--c-champagne-300) 70%, transparent),
      0 2px 3px color-mix(in srgb, var(--c-rose-700) 35%, transparent),
      0 10px 22px -10px color-mix(in srgb, var(--c-rose-700) 45%, transparent), var(--shadow-button-rose);
    box-shadow: var(--cover-button-shadow);
    color: var(--c-white);
    /* 1.25rem (20px) floor at a 375px viewport, growing toward 1.5rem on wider screens. */
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 600;
    /* Round-3 feedback: the earlier 0.08em tracking read as wide enough to make the label look
       smaller; tightened into the roomier 0.04-0.06em band. */
    letter-spacing: 0.05em;
    font-family: var(--font-display);
    /* Engraved look: only darkens around the glyphs, never lightens them. Rose, not wine. */
    text-shadow: 0 1px 1px color-mix(in srgb, var(--c-rose-700) 55%, transparent);
    cursor: pointer;
    transition: transform var(--motion-duration-base) var(--motion-easing);
    animation: cover-pulse 2.6s ease-out infinite;
  }

  .cover__open-button:hover {
    transform: translateY(-2px);
  }

  .cover__open-button:focus-visible {
    outline: 2px solid var(--c-champagne-500);
    outline-offset: 3px;
  }

  /* The relief responds to touch: the pill presses in and its inner shadow deepens. */
  .cover__open-button:active {
    transform: translateY(1px);
    --cover-button-shadow: inset 0 1px 0 color-mix(in srgb, var(--c-champagne-100) 60%, transparent),
      inset 0 -5px 9px color-mix(in srgb, var(--c-rose-700) 75%, var(--c-ink)),
      0 0 0 1px color-mix(in srgb, var(--c-champagne-300) 70%, transparent),
      0 1px 2px color-mix(in srgb, var(--c-rose-700) 35%, transparent), var(--shadow-button-rose);
  }

  /* Soft expanding champagne-gold ring, layered on top of the resting shadow so the shadow never
     blinks off. */
  @keyframes cover-pulse {
    0%,
    100% {
      box-shadow:
        var(--cover-button-shadow),
        0 0 0 0 color-mix(in srgb, var(--c-champagne-500) 45%, transparent);
    }
    70% {
      box-shadow:
        var(--cover-button-shadow),
        0 0 0 16px color-mix(in srgb, var(--c-champagne-500) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__open-button {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { OPEN_INVITATION_EVENT } from '../lib/events';

  const SCROLL_LOCK_CLASS = 'scroll-locked';

  // Gate the whole page behind the "Abrir invitación" click: lock scroll immediately (JS-only —
  // see tokens.css's `.scroll-locked` rule for why a JS failure never leaves the page stuck).
  document.body.classList.add(SCROLL_LOCK_CLASS);

  const openButton = document.querySelector(
    '[data-testid="open-invitation-button"]',
  ) as HTMLButtonElement | null;

  openButton?.addEventListener('click', () => {
    // Unlock BEFORE the programmatic scroll below — scrolling a locked root is a no-op.
    document.body.classList.remove(SCROLL_LOCK_CLASS);

    window.dispatchEvent(new CustomEvent(OPEN_INVITATION_EVENT));

    // "Opening" must be visible, not just audible: glide down to the countdown, which now sits
    // right after the cover. Guests who prefer reduced motion jump there instantly instead of
    // animating the scroll.
    const countdown = document.querySelector('[data-testid="countdown"]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    countdown?.scrollIntoView({
      behavior: prefersReducedMotion ? 'auto' : 'smooth',
      block: 'start',
    });
  });
</script>
