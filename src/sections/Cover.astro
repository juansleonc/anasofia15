---
// Landing screen; the "Abrir invitación" button is the only way past the cover (scroll is locked
// until it's clicked — see the script below). The click also dispatches `OPEN_INVITATION_EVENT`
// on `window`, which `islands/MusicToggle.astro` listens for to start playback — a loose
// window-event handshake so neither file needs to import or duplicate the other's audio element.
import RoseGarland from '../components/RoseGarland.astro';
import ConfettiBurst from '../islands/ConfettiBurst.astro';
import { event } from '../data/event';
---

<section class="cover" data-testid="cover" aria-label="Portada de la invitación">
  <RoseGarland placement="top" />
  <h1 class="cover__title">
    <span class="cover__title-lead">Invitación para los quince años de</span>{' '}
    <span class="cover__title-name font-cursive" data-testid="cover-celebrant-name">
      {event.celebrantName}
    </span>
  </h1>
  <button type="button" class="cover__open-button" data-testid="open-invitation-button">
    Abrir invitación
  </button>
  <RoseGarland placement="bottom" />
  <ConfettiBurst />
</section>

<style>
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vh, 2.25rem);
    min-height: 100dvh;
    padding: clamp(3.75rem, 14vh, 6rem) 1.25rem;
    text-align: center;
  }

  .cover__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    max-width: 26rem;
  }

  .cover__title-lead {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 4vw, 1.4rem);
    font-weight: 600;
    font-style: italic;
    color: var(--c-ink);
    letter-spacing: 0.01em;
  }

  .cover__title-name {
    display: inline-block;
    font-size: clamp(3.2rem, 15vw, 5.25rem);
    line-height: 1.3;
    padding: 0.1em 0.2em;
    color: var(--c-rose-700);
  }

  .cover__open-button {
    margin-top: 0.25rem;
    padding: 1rem 2.625rem;
    border: 1px solid var(--c-rose-300);
    border-radius: 999px;
    background: var(--gradient-button);
    color: var(--c-white);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-family: var(--font-body);
    cursor: pointer;
    box-shadow: var(--card-shadow);
    transition: transform var(--motion-duration-base) var(--motion-easing);
    animation: cover-pulse 2.6s ease-out infinite;
  }

  .cover__open-button:hover {
    transform: translateY(-2px);
  }

  /* Soft expanding rose ring, layered on top of the resting shadow so the shadow never blinks off. */
  @keyframes cover-pulse {
    0%,
    100% {
      box-shadow:
        var(--card-shadow),
        0 0 0 0 color-mix(in srgb, var(--c-rose-400) 45%, transparent);
    }
    70% {
      box-shadow:
        var(--card-shadow),
        0 0 0 16px color-mix(in srgb, var(--c-rose-400) 0%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__open-button {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { OPEN_INVITATION_EVENT } from '../lib/events';

  const SCROLL_LOCK_CLASS = 'scroll-locked';

  // Gate the whole page behind the "Abrir invitación" click: lock scroll immediately (JS-only —
  // see tokens.css's `.scroll-locked` rule for why a JS failure never leaves the page stuck).
  document.body.classList.add(SCROLL_LOCK_CLASS);

  const openButton = document.querySelector(
    '[data-testid="open-invitation-button"]',
  ) as HTMLButtonElement | null;

  openButton?.addEventListener('click', () => {
    // Unlock BEFORE the programmatic scroll below — scrolling a locked root is a no-op.
    document.body.classList.remove(SCROLL_LOCK_CLASS);

    window.dispatchEvent(new CustomEvent(OPEN_INVITATION_EVENT));

    // "Opening" must be visible, not just audible: glide down to the hero/name screen. Guests
    // who prefer reduced motion jump there instantly instead of animating the scroll.
    const hero = document.querySelector('[data-testid="hero"]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    hero?.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });
  });
</script>
