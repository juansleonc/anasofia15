---
// "Confirma tu lugar": header + the RsvpForm island, which owns the idle -> submitting ->
// success | error state machine wired to the pure validate/payload/guard logic in `src/lib/rsvp.ts`.
import RsvpForm from '../islands/RsvpForm.astro';
import EyebrowEmoji from '../components/EyebrowEmoji.astro';
import { event } from '../data/event';
---

<section class="rsvp" data-testid="rsvp" aria-label="RSVP">
  <div class="rsvp__header">
    <p class="rsvp__eyebrow"><EyebrowEmoji emoji="💌" />Confirma tu lugar</p>
    <h2 class="rsvp__title text-rose">¿Nos acompañas?</h2>
  </div>
  <p class="rsvp__admission-note" data-testid="rsvp-admission-note">{event.admissionNote}</p>
  <RsvpForm />
</section>

<style>
  .rsvp {
    padding: 2.5rem 1rem 4.375rem;
  }

  .rsvp__header {
    text-align: center;
    margin-bottom: 1.875rem;
  }

  .rsvp__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--c-rose-700);
  }

  .rsvp__title {
    font-weight: 700;
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    margin-top: 0.75rem;
  }

  .rsvp__admission-note {
    font-weight: 300;
    font-size: 0.9375rem;
    color: var(--c-ink-soft);
    opacity: 0.85;
    text-align: center;
    margin: 0 auto 1.875rem;
    max-width: 30rem;
  }
</style>
