---
// Dress-color wheel: a native radio group is the single source of truth for the selection (so
// tap and keyboard share one `change` path — the visually-hidden radios' own `<label>` doubles as
// a visible, tappable swatch row), paired with a purely decorative `aria-hidden` SVG that mirrors
// it. Slice geometry comes from the pure `color-wheel` module; this file only wires DOM events to
// it. Tapping a slice forwards to the matching radio's own `click()` rather than
// duplicating selection logic, and the rotor is an HTML box (not an SVG group) rotated via CSS —
// rotating an HTML box sidesteps SVG `transform-origin` quirks across browsers.
import { dressColors } from '../data/dress-colors';
import { slicePath } from '../lib/color-wheel';
import Rose from '../components/Rose.astro';

const CENTER = 100;
const SLICE_RADIUS = 82;
const RING_RADIUS = 90;
const HUB_RADIUS = 20;
---

<div class="color-wheel" data-testid="color-wheel">
  <div class="color-wheel__visual">
    <div class="color-wheel__pointer" aria-hidden="true">
      <Rose variant="bud" class="color-wheel__pointer-rose" />
    </div>

    <div class="color-wheel__rotor" data-testid="color-wheel-rotor" data-rotation="0">
      <svg viewBox="0 0 200 200" aria-hidden="true" class="color-wheel__svg">
        <circle class="color-wheel__ring" cx={CENTER} cy={CENTER} r={RING_RADIUS} />
        {
          dressColors.map((color, i) => (
            <path
              class="color-wheel__slice"
              data-testid="color-wheel-slice"
              data-index={i}
              d={slicePath(i, dressColors.length, SLICE_RADIUS, CENTER)}
              style={`fill: ${color.hex}`}
            />
          ))
        }
        <circle class="color-wheel__hub" cx={CENTER} cy={CENTER} r={HUB_RADIUS} />
      </svg>
    </div>
  </div>

  <fieldset class="color-wheel__fieldset" data-testid="color-wheel-fieldset">
    <legend class="color-wheel__legend">Elige un color para tu vestido</legend>
    <div class="color-wheel__options">
      {
        dressColors.map((color, i) => (
          <span class="color-wheel__option">
            <input
              type="radio"
              name="dress-color"
              id={`color-wheel-option-${i}`}
              data-testid="color-wheel-option"
              data-index={i}
              class="color-wheel__radio"
            />
            <label
              for={`color-wheel-option-${i}`}
              class="color-wheel__label"
              style={`--option-color: ${color.hex}`}
            >
              {color.name}
            </label>
          </span>
        ))
      }
    </div>
  </fieldset>

  <p class="color-wheel__hint" data-testid="color-wheel-hint">Toca un color de la rueda</p>

  <div class="color-wheel__detail" data-testid="color-wheel-detail" aria-live="polite" hidden>
    <span class="color-wheel__detail-swatch" data-testid="color-wheel-swatch" aria-hidden="true" />
    <p class="color-wheel__detail-name" data-testid="color-wheel-name" />
    <p class="color-wheel__detail-note" data-testid="color-wheel-note" hidden />
  </div>
</div>

<style>
  .color-wheel {
    max-width: 22rem;
    margin: 0 auto;
    text-align: center;
  }

  .color-wheel__visual {
    position: relative;
    width: clamp(220px, 70vw, 280px);
    aspect-ratio: 1;
    margin: 0 auto 1.5rem;
  }

  .color-wheel__pointer {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 1.25rem;
    transform: translateX(-50%);
    z-index: 1;
  }

  .color-wheel__rotor {
    width: 100%;
    height: 100%;
    transform: rotate(var(--wheel-rotation, 0deg));
    transition: transform var(--motion-duration-slow) var(--motion-easing);
  }

  .color-wheel__svg {
    width: 100%;
    height: 100%;
  }

  .color-wheel__ring {
    fill: none;
    stroke: var(--c-rose-700);
    stroke-width: 3;
  }

  .color-wheel__slice {
    stroke: white;
    stroke-width: 2;
  }

  .color-wheel__slice[data-focused='true'] {
    stroke: var(--c-ink);
    stroke-width: 3;
  }

  .color-wheel__hub {
    fill: var(--c-rose-700);
  }

  .color-wheel__fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .color-wheel__legend,
  .color-wheel__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .color-wheel__options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }

  .color-wheel__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--c-rose-300);
    font-size: 0.8125rem;
    color: var(--c-ink);
    cursor: pointer;
  }

  .color-wheel__label::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--option-color);
  }

  .color-wheel__radio:checked + .color-wheel__label {
    border-color: var(--c-rose-700);
    font-weight: 700;
  }

  .color-wheel__radio:focus-visible + .color-wheel__label {
    outline: 2px solid var(--c-rose-700);
    outline-offset: 2px;
  }

  .color-wheel__hint {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
  }

  .color-wheel__hint[hidden] {
    display: none;
  }

  .color-wheel__detail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.75rem;
  }

  .color-wheel__detail[hidden] {
    display: none;
  }

  .color-wheel__detail-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--c-rose-300);
  }

  .color-wheel__detail-name {
    font-weight: 700;
    color: var(--c-ink);
    margin: 0;
  }

  .color-wheel__detail-note {
    font-size: 0.875rem;
    color: var(--c-ink-soft);
    margin: 0;
  }

  .color-wheel__detail-note[hidden] {
    display: none;
  }
</style>

<script>
  import { dressColors } from '../data/dress-colors';
  import { nextRotation } from '../lib/color-wheel';

  const COUNT = dressColors.length;

  const rotor = document.querySelector('[data-testid="color-wheel-rotor"]') as HTMLElement | null;
  const fieldset = document.querySelector('[data-testid="color-wheel-fieldset"]');
  const radios = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-testid="color-wheel-option"]'),
  );
  const slices = Array.from(
    document.querySelectorAll<SVGPathElement>('[data-testid="color-wheel-slice"]'),
  );
  const hint = document.querySelector('[data-testid="color-wheel-hint"]') as HTMLElement | null;
  const detail = document.querySelector('[data-testid="color-wheel-detail"]') as HTMLElement | null;
  const swatch = document.querySelector(
    '[data-testid="color-wheel-swatch"]',
  ) as HTMLElement | null;
  const nameEl = document.querySelector('[data-testid="color-wheel-name"]');
  const noteEl = document.querySelector('[data-testid="color-wheel-note"]') as HTMLElement | null;

  let rotation = 0;

  function select(index: number): void {
    const color = dressColors[index];
    if (!color) return;

    rotation = nextRotation(rotation, index, COUNT);
    if (rotor) {
      rotor.style.setProperty('--wheel-rotation', `${rotation}deg`);
      rotor.dataset.rotation = String(rotation);
    }

    if (detail) detail.hidden = false;
    if (swatch) swatch.style.backgroundColor = color.hex;
    if (nameEl) nameEl.textContent = color.name;
    if (noteEl) {
      noteEl.hidden = color.note === null;
      noteEl.textContent = color.note ?? '';
    }
    if (hint) hint.hidden = true;

    slices.forEach((slice, i) => {
      slice.classList.toggle('color-wheel__slice--selected', i === index);
    });
  }

  slices.forEach((slice, i) => {
    slice.addEventListener('click', () => radios[i]?.click());
  });

  fieldset?.addEventListener('change', (event) => {
    const index = radios.indexOf(event.target as HTMLInputElement);
    if (index === -1) return;
    select(index);
  });

  radios.forEach((radio, i) => {
    radio.addEventListener('focus', () => slices[i]?.setAttribute('data-focused', 'true'));
    radio.addEventListener('blur', () => slices[i]?.removeAttribute('data-focused'));
  });

  function focusedIndex(): number {
    const fromFocus = radios.indexOf(document.activeElement as HTMLInputElement);
    if (fromFocus !== -1) return fromFocus;
    const checked = radios.findIndex((radio) => radio.checked);
    return checked === -1 ? 0 : checked;
  }

  // Belt-and-suspenders keyboard handling: native radio-group arrow-key behavior should already
  // move + check the next/previous option, but WebKit support for that is unconfirmed (see the
  // design's own risk note) — this handler guarantees the same ArrowRight/Down/Left/Up + wrap
  // behavior regardless, always finishing through the shared `radios[i].click()` → `change` path.
  fieldset?.addEventListener('keydown', (event) => {
    const key = event.key;
    if (key !== 'ArrowRight' && key !== 'ArrowDown' && key !== 'ArrowLeft' && key !== 'ArrowUp') {
      return;
    }

    event.preventDefault();
    const current = focusedIndex();
    const forward = key === 'ArrowRight' || key === 'ArrowDown';
    const next = forward ? (current + 1) % COUNT : (current - 1 + COUNT) % COUNT;
    radios[next]?.focus();
    radios[next]?.click();
  });
</script>
