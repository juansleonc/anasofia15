---
// One-shot metallic-paper confetti burst fired by the "Abrir invitación" open gesture. Listens
// for the same loose `lu15:open-invitation` window event MusicToggle uses (Cover dispatches it;
// this island never touches the button or the scroll gate), throws a capped batch of silver-
// dominant paper bits UP from around the button, lets gravity + per-piece flutter bring them
// down, then clears the canvas and cancels its RAF — zero idle cost before and after the burst.
// Particle initialization is the pure, unit-tested `createBurstPieces` (src/lib/confetti.ts);
// only the canvas rendering lives here. The canvas reports its state on `data-confetti`
// (fired/skipped) and `data-confetti-bursts` so tests can observe the burst without pixel
// sampling. `prefers-reduced-motion` skips the burst entirely; if JS or the event never arrives,
// the canvas just sits inert (progressive enhancement).
---

<canvas class="confetti" data-testid="confetti" aria-hidden="true"></canvas>

<style>
  .confetti {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Above the cover art; never above pointer reach — the canvas ignores all input. */
    z-index: 20;
    pointer-events: none;
  }
</style>

<script>
  import { createBurstPieces, type ConfettiPiece } from '../lib/confetti';
  import { OPEN_INVITATION_EVENT } from '../lib/events';

  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';
  const PIECE_COUNT = 150;
  const BURST_DURATION_S = 4.2;
  /** px/s² — heavy enough that the toss arcs over within the first second. */
  const GRAVITY = 920;
  /** px of side-to-side flutter a falling piece adds on top of its ballistic path. */
  const FLUTTER_DRIFT = 42;

  function initConfettiBurst(): void {
    const canvasEl = document.querySelector<HTMLCanvasElement>('[data-testid="confetti"]');
    const context = canvasEl?.getContext('2d');
    if (!canvasEl || !context) return;

    // Rebind as definite locals so the nested closures below see non-nullable types (same
    // pattern as Starfield: TS narrowing doesn't flow into nested function bodies).
    const canvas: HTMLCanvasElement = canvasEl;
    const ctx: CanvasRenderingContext2D = context;

    let pieces: ConfettiPiece[] = [];
    let elapsed = 0;
    let lastTime = 0;
    let rafId = 0;

    function paletteFromTokens() {
      const styles = getComputedStyle(document.documentElement);
      const token = (name: string, fallback: string) =>
        styles.getPropertyValue(name).trim() || fallback;
      return {
        silver: [token('--c-silver', '#c9ccd1'), token('--c-bright', '#eef0f3'), '#ffffff'],
        gold: [token('--c-gold', '#d4af37'), token('--c-gold-bright', '#f0d987')],
      };
    }

    function drawFrame(): void {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      // Fade the whole burst out over its final second so the papers settle instead of popping.
      const fade = Math.min(1, (BURST_DURATION_S - elapsed) / 1);
      for (const piece of pieces) {
        const flutter = Math.sin(elapsed * piece.wobbleSpeed + piece.wobblePhase);
        ctx.save();
        ctx.globalAlpha = Math.max(0, fade);
        ctx.translate(piece.x + flutter * FLUTTER_DRIFT * 0.25, piece.y);
        ctx.rotate(piece.rotation);
        // Foreshorten one axis with the flutter phase so each rectangle reads as paper
        // flipping over in the air, not a flat card sliding down.
        ctx.scale(1, 0.25 + 0.75 * Math.abs(flutter));
        ctx.fillStyle = piece.color;
        ctx.fillRect(-piece.width / 2, -piece.height / 2, piece.width, piece.height);
        ctx.restore();
      }
    }

    function loop(now: number): void {
      const dt = lastTime === 0 ? 0 : Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;
      elapsed += dt;

      if (elapsed >= BURST_DURATION_S) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        pieces = [];
        rafId = 0;
        return; // no further RAF — the island goes fully idle after the burst settles
      }

      for (const piece of pieces) {
        piece.vy += GRAVITY * dt;
        piece.x += piece.vx * dt;
        piece.y += piece.vy * dt;
        piece.rotation += piece.rotationSpeed * dt;
        // Horizontal toss decays gently; what's left is the flutter drift applied at draw time.
        piece.vx *= 1 - 0.8 * dt;
      }

      drawFrame();
      rafId = requestAnimationFrame(loop);
    }

    function fire(): void {
      if (window.matchMedia(REDUCED_MOTION_QUERY).matches) {
        canvas.dataset.confetti = 'skipped';
        return;
      }
      if (rafId !== 0 || canvas.dataset.confetti === 'fired') return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Throw from around the open button (the guest's finger), falling back to bottom-center.
      const button = document.querySelector('[data-testid="open-invitation-button"]');
      const rect = button?.getBoundingClientRect();
      const originX = rect ? rect.left + rect.width / 2 : window.innerWidth / 2;
      const originY = rect ? rect.top + rect.height / 2 : window.innerHeight * 0.8;

      pieces = createBurstPieces({
        count: PIECE_COUNT,
        originX,
        originY,
        palette: paletteFromTokens(),
      });

      canvas.dataset.confetti = 'fired';
      canvas.dataset.confettiBursts = String(Number(canvas.dataset.confettiBursts ?? '0') + 1);
      elapsed = 0;
      lastTime = 0;
      rafId = requestAnimationFrame(loop);
    }

    // `once` is the primary one-shot guard; `fire` itself re-checks so a manually re-dispatched
    // event can never restart a burst.
    window.addEventListener(OPEN_INVITATION_EVENT, fire, { once: true });
  }

  initConfettiBurst();
</script>
